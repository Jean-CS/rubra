---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import {
	COURSE_AREA_LABELS,
	COURSE_ESTIMATED_FIELD_LABELS,
	COURSE_MEC_STATUS_LABELS,
	formatCourseReviewDate,
	formatCourseTuition,
	getRelatedCourses,
	isEstimatedCourseField,
} from "../../../lib/courses";

export async function getStaticPaths() {
	const allCourses = await getCollection("courses", ({ data }) => !data.draft);
	const institutions = await getCollection("institutions", ({ data }) => !data.draft);

	return allCourses.map((course) => {
		const [institutionId, courseSlug] = course.id.split("/");
		const institution = institutions.find((i) => i.id === institutionId);
		const relatedCourses = getRelatedCourses(allCourses, course).map((relatedCourse) => {
			const [relatedInstitutionId] = relatedCourse.id.split("/");
			return {
				course: relatedCourse,
				institution: institutions.find(({ id }) => id === relatedInstitutionId),
			};
		});
		return {
			params: { id: institutionId, courseId: courseSlug },
			props: { course, institution, relatedCourses },
		};
	});
}

const { course, institution, relatedCourses } = Astro.props;
const { data } = course;

const githubIssueBaseUrl = "https://github.com/Jean-CS/rubra/issues/new";

const updateIssueUrl = new URL(`${githubIssueBaseUrl}?template=atualizar-curso.yml`);
updateIssueUrl.searchParams.set("title", `Atualizar curso: ${data.name}`);
updateIssueUrl.searchParams.set("institution", institution?.data.name ?? "");
updateIssueUrl.searchParams.set("course", data.name);
updateIssueUrl.searchParams.set("level", data.level);

const headerLinks = [
	{ href: "/comunidades", label: "Comunidades", accent: "lime" },
	{ href: "/instituicoes", label: "Ensino", accent: "cyan" },
	{ href: "/cursos", label: "Cursos", accent: "cyan" },
	{ href: "/eventos", label: "Eventos", accent: "coral" },
	{ href: "/sobre", label: "Sobre", accent: "violet" },
	{ href: `${githubIssueBaseUrl}?template=indicar-instituicao.yml`, label: "Indicar", accent: "cyan" },
] as const;

const [institutionId] = course.id.split("/");
const institutionAccent = institution?.data.accent ?? "cyan";
const tuitionLabel = formatCourseTuition(data.tuition);
const mecLabel = data.mec
	? data.mec.status === "rated"
		? `Conceito MEC ${data.mec.grade}/5`
		: COURSE_MEC_STATUS_LABELS[data.mec.status]
	: undefined;
const atAGlance = [
	{ label: "Nível", value: data.level },
	data.modality && { label: "Modalidade", value: data.modality, field: "modality" as const },
	{ label: data.shifts.length > 1 ? "Turnos" : "Turno", value: data.shifts.join(" e "), field: "shifts" as const },
	data.duration && { label: "Duração", value: data.duration, field: "duration" as const },
	data.workload && { label: "Carga horária", value: data.workload, field: "workload" as const },
	data.campus && { label: "Local", value: data.campus, field: "campus" as const },
	tuitionLabel && { label: "Mensalidade", value: tuitionLabel, detail: data.tuition?.note, field: "tuition" as const },
	mecLabel && { label: "MEC", value: mecLabel, detail: data.mec?.note, field: "mec" as const },
].filter(Boolean) as Array<{
	label: string;
	value: string;
	detail?: string;
	field?: Parameters<typeof isEstimatedCourseField>[1];
}>;
const externalUrl = data.officialUrl ?? institution?.data.website;
const externalLabel = data.officialUrl ? "Ver página oficial do curso" : "Visitar site da instituição";
const reviewDate = data.verification ? formatCourseReviewDate(data.verification.reviewedAt) : undefined;
---

<Layout
	title={`${data.name} — ${institution?.data.name ?? "Instituição"} em Londrina | Rubra`}
	description={`${data.description} Veja modalidade, turno, duração, ingresso, currículo e fontes.`}
>
	<div class={`detail-page accent-${institutionAccent}`}>
		<SiteHeader links={headerLinks} />

		<main class="detail-main">
			<header class="detail-header">
				<p class="detail-eyebrow">
					{institution ? (
						<>
							<a href="/cursos">Cursos em Londrina</a>
							<span class="eyebrow-sep" aria-hidden="true">·</span>
							<a href={`/instituicoes/${institutionId}`}>{institution.data.name}</a>
							<span class="eyebrow-sep" aria-hidden="true">·</span>
							<span class="eyebrow-meta">{institution.data.type}</span>
							<span class="eyebrow-sep" aria-hidden="true">·</span>
							<span class="eyebrow-meta">{institution.data.profile}</span>
						</>
					) : (
						<a href="/instituicoes">Ensino e formação</a>
					)}
				</p>
				<h1>{data.name}</h1>
				<div class="course-badges">
					<span class="level-badge-prominent">{data.level}</span>
					<span class="meta-badge">{COURSE_AREA_LABELS[data.area]}</span>
				</div>
				<p class="detail-description">{data.description}</p>
			</header>

			<div class="detail-body">
				<section class="detail-section overview-section" aria-labelledby="overview-title">
					<h2 id="overview-title" class="section-label">Visão geral</h2>
					<dl class="facts-grid">
						{atAGlance.map((item) => {
							const estimated = item.field && isEstimatedCourseField(data.verification?.estimatedFields, item.field);
							return (
								<div class="fact-card">
									<dt>{item.label}</dt>
									<dd>
										{item.value}
										{estimated && <span class="estimate-label">Estimativa</span>}
									</dd>
									{item.detail && <p>{item.detail}</p>}
								</div>
							);
						})}
					</dl>
				</section>

				{data.admission && (
					<section class="detail-section prose-section" aria-labelledby="admission-title">
						<h2 id="admission-title">Como ingressar</h2>
						<p>{data.admission.summary}</p>
						{data.admission.url && (
							<a href={data.admission.url} target="_blank" rel="noopener noreferrer" class="inline-link">
								Consultar processo seletivo →
							</a>
						)}
					</section>
				)}

				{data.curriculumHighlights && (
					<section class="detail-section prose-section" aria-labelledby="curriculum-title">
						<h2 id="curriculum-title">O que você vai estudar</h2>
						<ul class="curriculum-list">
							{data.curriculumHighlights.map((highlight) => <li>{highlight}</li>)}
						</ul>
					</section>
				)}

				{data.tags.length > 0 && (
					<section class="detail-section" aria-labelledby="topics-title">
						<h2 id="topics-title" class="section-label">Tópicos</h2>
						<div class="topic-chips">
							{data.tags.map((tag) => (
								<span class="topic-chip">{tag}</span>
							))}
						</div>
					</section>
				)}

				{externalUrl && (
					<div class="apply-section">
						<a
							href={externalUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="apply-btn"
						>
							{externalLabel} →
						</a>
					</div>
				)}

				{(data.sources || data.verification) && (
					<section class="detail-section sources-section" aria-labelledby="sources-title">
						<h2 id="sources-title">Fontes e atualização</h2>
						{data.sources && (
							<ul class="source-list">
								{data.sources.map((source) => (
									<li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} ↗</a></li>
								))}
							</ul>
						)}
						{reviewDate && (
							<p class="verification-note">
								Revisado em {reviewDate}. {data.verification?.status === "verified"
									? "Dados conferidos nas fontes listadas."
									: "Verificação parcial: alguns dados ainda precisam de confirmação."}
							</p>
						)}
						{data.verification?.estimatedFields && data.verification.estimatedFields.length > 0 && (
							<p class="estimate-note">
								<strong>Estimativas nesta página:</strong>{" "}
								{data.verification.estimatedFields.map((field) => COURSE_ESTIMATED_FIELD_LABELS[field]).join(", ")}.
							</p>
						)}
					</section>
				)}

				{relatedCourses.length > 0 && (
					<section class="detail-section" aria-labelledby="related-title">
						<h2 id="related-title">Cursos semelhantes em Londrina</h2>
						<div class="related-grid">
							{relatedCourses.map(({ course: relatedCourse, institution: relatedInstitution }) => {
								const [relatedInstitutionId, relatedSlug] = relatedCourse.id.split("/");
								return (
									<a
										href={`/instituicoes/${relatedInstitutionId}/${relatedSlug}`}
										class="related-card"
									>
										<div class="related-card-inner">
											<span class="related-institution">{relatedInstitution?.data.name}</span>
											<span class="related-name">{relatedCourse.data.name}</span>
											<span class="level-badge">{relatedCourse.data.level}</span>
										</div>
										<span class="related-arrow" aria-hidden="true">→</span>
									</a>
								);
							})}
						</div>
						{institution && (
							<a href={`/instituicoes/${institutionId}`} class="see-all-link">
								Ver todos os cursos de {institution.data.name} →
							</a>
						)}
					</section>
				)}

				<div class="detail-action">
					<a href={updateIssueUrl.toString()} class="action-link">
						Atualizar dados deste curso →
					</a>
				</div>
			</div>
		</main>

		<SiteFooter />
	</div>
</Layout>

<style>
	.detail-page {
		--page-gutter: clamp(18px, 3.8vw, 42px);
		--accent-color: var(--cyan, #22d3c5);
		position: relative;
		min-height: 100dvh;
		overflow-x: clip;
		background:
			linear-gradient(90deg, rgba(22, 15, 11, 0.01) 1px, transparent 1px),
			linear-gradient(rgba(22, 15, 11, 0.01) 1px, transparent 1px),
			var(--paper, #f8f1e7);
		background-size: 42px 42px, 42px 42px, auto;
		color: var(--ink, #160f0b);
		font-family: var(--body, "IBM Plex Sans", system-ui, sans-serif);
	}

	.detail-page *,
	.detail-page *::before,
	.detail-page *::after {
		box-sizing: border-box;
	}

	.detail-page.accent-lime { --accent-color: var(--lime, #b7ff4a); }
	.detail-page.accent-cyan { --accent-color: var(--cyan, #22d3c5); }
	.detail-page.accent-coral { --accent-color: var(--coral, #ff6247); }
	.detail-page.accent-violet { --accent-color: var(--violet, #6f5ae8); }
	.detail-page.accent-red { --accent-color: var(--red, #e53935); }

	.detail-main {
		position: relative;
		z-index: 1;
		width: min(860px, calc(100% - (var(--page-gutter) * 2)));
		margin-inline: auto;
		padding-block: clamp(28px, 5vw, 64px);
	}

	/* ── Header ── */

	.detail-header {
		padding-bottom: clamp(28px, 4vw, 48px);
		border-bottom: 2px solid var(--accent-color);
		margin-bottom: clamp(28px, 4vw, 48px);
	}

	.detail-eyebrow {
		margin: 0 0 16px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 5px 8px;
		color: var(--steel, #766a5e);
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.74rem;
		font-weight: 600;
	}

	.detail-eyebrow a {
		color: inherit;
		text-decoration: none;
		transition: color 150ms ease;
	}

	.detail-eyebrow a:hover {
		color: var(--ink, #160f0b);
	}

	.eyebrow-sep {
		user-select: none;
		opacity: 0.5;
	}

	.eyebrow-meta {
		opacity: 0.7;
	}

	h1 {
		margin: 0 0 16px;
		font-family: var(--display, "Bricolage Grotesque", sans-serif);
		font-size: clamp(2rem, 5vw, 3.2rem);
		font-weight: 800;
		line-height: 1.05;
	}

	.course-badges {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin-bottom: 18px;
	}

	.level-badge-prominent {
		display: inline-flex;
		align-items: center;
		padding: 5px 14px;
		background: var(--accent-color);
		color: var(--ink, #160f0b);
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		line-height: 1;
	}

	.meta-badge {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		padding: 5px 12px;
		border: 1px solid rgba(22, 15, 11, 0.18);
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--steel, #766a5e);
		line-height: 1;
	}

	.meta-badge--free {
		border-color: color-mix(in srgb, var(--lime, #b7ff4a) 50%, transparent);
		background: color-mix(in srgb, var(--lime, #b7ff4a) 12%, transparent);
		color: color-mix(in srgb, var(--lime, #b7ff4a) 30%, var(--ink, #160f0b));
	}

	.mec-badge {
		display: inline-flex;
		align-items: center;
		padding: 5px 12px;
		border: 1px solid color-mix(in srgb, var(--accent-color) 45%, transparent);
		background: color-mix(in srgb, var(--accent-color) 10%, transparent);
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.7rem;
		font-weight: 700;
		color: color-mix(in srgb, var(--accent-color) 70%, var(--ink, #160f0b));
		line-height: 1;
		letter-spacing: 0.03em;
	}

	.detail-description {
		margin: 0;
		max-width: 640px;
		color: var(--steel, #766a5e);
		line-height: 1.65;
		font-size: 1rem;
	}

	/* ── Body grid ── */

	.detail-body {
		display: grid;
		gap: clamp(28px, 4vw, 48px);
	}

	.detail-section {
		border-top: 1px solid rgba(22, 15, 11, 0.12);
		padding-top: clamp(20px, 3vw, 32px);
	}

	.detail-section > h2:not(.section-label) {
		margin: 0 0 14px;
		font-family: var(--display, "Bricolage Grotesque", sans-serif);
		font-size: clamp(1.3rem, 3vw, 1.7rem);
		line-height: 1.15;
	}

	.section-label {
		margin: 0 0 16px;
		color: var(--steel, #766a5e);
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.74rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	/* ── Decision facts ── */

	.overview-section {
		border-top: 0;
		padding-top: 0;
	}

	.facts-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1px;
		margin: 0;
		border: 1px solid rgba(22, 15, 11, 0.12);
		background: rgba(22, 15, 11, 0.12);
	}

	.fact-card {
		min-width: 0;
		padding: 16px 18px;
		background: var(--paper, #f8f1e7);
	}

	.fact-card dt {
		margin-bottom: 5px;
		color: var(--steel, #766a5e);
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.64rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.fact-card dd {
		margin: 0;
		font-weight: 700;
		line-height: 1.35;
	}

	.fact-card p {
		margin: 7px 0 0;
		color: var(--steel, #766a5e);
		font-size: 0.78rem;
		line-height: 1.45;
	}

	.estimate-label {
		display: inline-block;
		margin-left: 7px;
		padding: 2px 6px;
		border: 1px solid color-mix(in srgb, var(--coral, #ff6247) 45%, transparent);
		color: color-mix(in srgb, var(--coral, #ff6247) 72%, var(--ink, #160f0b));
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.55rem;
		font-weight: 700;
		text-transform: uppercase;
		vertical-align: 2px;
	}

	/* ── Admissions and curriculum ── */

	.prose-section > p {
		max-width: 680px;
		margin: 0 0 10px;
		color: var(--steel, #766a5e);
		line-height: 1.65;
	}

	.inline-link,
	.source-list a {
		color: inherit;
		font-weight: 650;
		text-underline-offset: 3px;
		text-decoration-thickness: 1px;
	}

	.inline-link:hover,
	.source-list a:hover {
		color: color-mix(in srgb, var(--accent-color) 72%, var(--ink, #160f0b));
	}

	.curriculum-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 10px 24px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.curriculum-list li {
		position: relative;
		padding-left: 18px;
		line-height: 1.45;
	}

	.curriculum-list li::before {
		content: "→";
		position: absolute;
		left: 0;
		color: color-mix(in srgb, var(--accent-color) 78%, var(--ink, #160f0b));
		font-weight: 800;
	}

	/* ── Topics ── */

	.topic-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
	}

	.topic-chip {
		padding: 5px 12px;
		border: 1px solid rgba(22, 15, 11, 0.14);
		background: rgba(22, 15, 11, 0.025);
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.72rem;
		font-weight: 600;
		line-height: 1;
	}

	/* ── Apply CTA ── */

	.apply-section {
		border-top: 1px solid rgba(22, 15, 11, 0.12);
		padding-top: clamp(20px, 3vw, 32px);
	}

	.apply-btn {
		display: inline-block;
		padding: 14px 28px;
		background: var(--ink, #160f0b);
		color: var(--paper, #f8f1e7);
		font-family: var(--body, "IBM Plex Sans", system-ui, sans-serif);
		font-weight: 700;
		font-size: 0.95rem;
		text-decoration: none;
		letter-spacing: 0.01em;
		transition: background 200ms ease, color 200ms ease;
	}

	.apply-btn:hover {
		background: var(--accent-color);
		color: var(--ink, #160f0b);
	}

	/* ── Sources ── */

	.source-list {
		display: grid;
		gap: 8px;
		margin: 0 0 18px;
		padding-left: 20px;
	}

	.verification-note,
	.estimate-note {
		margin: 8px 0 0;
		max-width: 680px;
		color: var(--steel, #766a5e);
		font-size: 0.82rem;
		line-height: 1.55;
	}

	.estimate-note {
		padding: 10px 12px;
		border-left: 3px solid var(--coral, #ff6247);
		background: color-mix(in srgb, var(--coral, #ff6247) 7%, transparent);
	}

	/* ── Related courses ── */

	.related-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1px;
		background: rgba(22, 15, 11, 0.1);
		border: 1px solid rgba(22, 15, 11, 0.1);
		margin-bottom: 14px;
	}

	.related-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 16px 18px;
		color: inherit;
		text-decoration: none;
		background: var(--paper, #f8f1e7);
		transition: background 160ms ease;
	}

	.related-card:hover {
		background: color-mix(in srgb, var(--accent-color) 9%, var(--paper, #f8f1e7));
	}

	.related-card-inner {
		display: flex;
		flex-direction: column;
		gap: 6px;
		min-width: 0;
	}

	.related-institution {
		color: var(--steel, #766a5e);
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.62rem;
		font-weight: 650;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.related-name {
		font-weight: 700;
		font-size: 0.9rem;
		line-height: 1.3;
		transition: color 160ms ease;
	}

	.related-card:hover .related-name {
		color: color-mix(in srgb, var(--accent-color) 75%, var(--ink, #160f0b));
	}

	.level-badge {
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.58rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 2px 7px;
		border: 1px solid color-mix(in srgb, var(--accent-color) 45%, transparent);
		background: color-mix(in srgb, var(--accent-color) 10%, transparent);
		display: inline-block;
		align-self: flex-start;
		line-height: 1.6;
		white-space: nowrap;
	}

	.related-arrow {
		color: var(--steel, #766a5e);
		flex-shrink: 0;
		font-size: 1rem;
		transition: transform 160ms ease, color 160ms ease;
	}

	.related-card:hover .related-arrow {
		transform: translateX(4px);
		color: var(--accent-color);
	}

	.see-all-link {
		display: inline-block;
		font-size: 0.86rem;
		font-weight: 600;
		color: var(--steel, #766a5e);
		text-decoration: none;
		transition: color 150ms ease;
	}

	.see-all-link:hover {
		color: var(--ink, #160f0b);
	}

	/* ── Action CTA ── */

