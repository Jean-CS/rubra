---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";

export async function getStaticPaths() {
	const allCourses = await getCollection("courses", ({ data }) => !data.draft);
	const institutions = await getCollection("institutions", ({ data }) => !data.draft);

	return allCourses.map((course) => {
		const [institutionId, courseSlug] = course.id.split("/");
		const institution = institutions.find((i) => i.id === institutionId);
		const siblingCourses = allCourses
			.filter((c) => c.id.startsWith(`${institutionId}/`) && c.id !== course.id)
			.slice(0, 4);
		return {
			params: { id: institutionId, courseId: courseSlug },
			props: { course, institution, siblingCourses },
		};
	});
}

const { course, institution, siblingCourses } = Astro.props;
const { data } = course;

const githubIssueBaseUrl = "https://github.com/Jean-CS/rubra/issues/new";

const updateIssueUrl = new URL(`${githubIssueBaseUrl}?template=atualizar-curso.yml`);
updateIssueUrl.searchParams.set("title", `Atualizar curso: ${data.name}`);
updateIssueUrl.searchParams.set("institution", institution?.data.name ?? "");
updateIssueUrl.searchParams.set("course", data.name);
updateIssueUrl.searchParams.set("level", data.level);

const headerLinks = [
	{ href: "/comunidades", label: "Comunidades", accent: "lime" },
	{ href: "/instituicoes", label: "Ensino", accent: "cyan" },
	{ href: "/eventos", label: "Eventos", accent: "coral" },
	{ href: "/sobre", label: "Sobre", accent: "violet" },
	{ href: `${githubIssueBaseUrl}?template=indicar-instituicao.yml`, label: "Indicar", accent: "cyan" },
] as const;

const [institutionId] = course.id.split("/");
const institutionAccent = institution?.data.accent ?? "cyan";

const hasMeta = data.modality || data.duration;
---

<Layout
	title={`${data.name} — ${institution?.data.name ?? "Instituição"} | Rubra`}
	description={data.description ?? `${data.name} — ${data.level} em ${institution?.data.name ?? "instituição"}.`}
>
	<div class={`detail-page accent-${institutionAccent}`}>
		<SiteHeader links={headerLinks} />

		<main class="detail-main">
			<header class="detail-header">
				<p class="detail-eyebrow">
					{institution ? (
						<>
							<a href={`/instituicoes/${institutionId}`}>{institution.data.name}</a>
							<span class="eyebrow-sep" aria-hidden="true">·</span>
							<span class="eyebrow-meta">{institution.data.type}</span>
							<span class="eyebrow-sep" aria-hidden="true">·</span>
							<span class="eyebrow-meta">{institution.data.profile}</span>
						</>
					) : (
						<a href="/instituicoes">Ensino e formação</a>
					)}
				</p>
				<h1>{data.name}</h1>
				<div class="course-badges">
					<span class="level-badge-prominent">{data.level}</span>
					{data.modality && (
						<span class="meta-badge">
							<span aria-hidden="true">◈</span>{data.modality}
						</span>
					)}
					{data.shift && (
						<span class="meta-badge">
							<span aria-hidden="true">◷</span>{data.shift}
						</span>
					)}
					{data.duration && (
						<span class="meta-badge">
							<span aria-hidden="true">⏱</span>{data.duration}
						</span>
					)}
					{data.workload && (
						<span class="meta-badge">
							<span aria-hidden="true">◉</span>{data.workload}
						</span>
					)}
					{data.tuition && (
						<span class={`meta-badge${data.tuition === "Gratuito" ? " meta-badge--free" : ""}`}>
							<span aria-hidden="true">◈</span>{data.tuition}
						</span>
					)}
					{typeof data.mec_grade === "number" && (
						<span class="mec-badge">
							MEC {"★".repeat(data.mec_grade)}{"☆".repeat(5 - data.mec_grade)}
						</span>
					)}
				</div>
				{data.description && (
					<p class="detail-description">{data.description}</p>
				)}
			</header>

			<div class="detail-body">
				{data.tags && data.tags.length > 0 && (
					<section class="detail-section" aria-labelledby="topics-title">
						<h2 id="topics-title" class="section-label">Tópicos</h2>
						<div class="topic-chips">
							{data.tags.map((tag) => (
								<span class="topic-chip">{tag}</span>
							))}
						</div>
					</section>
				)}

				{data.url && (
					<div class="apply-section">
						<a
							href={data.url}
							target="_blank"
							rel="noopener noreferrer"
							class="apply-btn"
						>
							Acessar site do curso →
						</a>
					</div>
				)}

				{siblingCourses.length > 0 && (
					<section class="detail-section" aria-labelledby="related-title">
						<h2 id="related-title" class="section-label">
							Outros cursos {institution ? `em ${institution.data.name}` : "desta instituição"}
						</h2>
						<div class="related-grid">
							{siblingCourses.map((sibling) => {
								const [sibInstId, sibSlug] = sibling.id.split("/");
								return (
									<a
										href={`/instituicoes/${sibInstId}/${sibSlug}`}
										class="related-card"
									>
										<div class="related-card-inner">
											<span class="related-name">{sibling.data.name}</span>
											<span class="level-badge">{sibling.data.level}</span>
										</div>
										<span class="related-arrow" aria-hidden="true">→</span>
									</a>
								);
							})}
						</div>
						{institution && (
							<a href={`/instituicoes/${institutionId}`} class="see-all-link">
								Ver todos os cursos de {institution.data.name} →
							</a>
						)}
					</section>
				)}

				<div class="detail-action">
					<a href={updateIssueUrl.toString()} class="action-link">
						Atualizar dados deste curso →
					</a>
				</div>
			</div>
		</main>

		<SiteFooter />
	</div>
</Layout>

<style>
	.detail-page {
		--page-gutter: clamp(18px, 3.8vw, 42px);
		--accent-color: var(--cyan, #22d3c5);
		position: relative;
		min-height: 100dvh;
		overflow-x: clip;
		background:
			linear-gradient(90deg, rgba(22, 15, 11, 0.01) 1px, transparent 1px),
			linear-gradient(rgba(22, 15, 11, 0.01) 1px, transparent 1px),
			var(--paper, #f8f1e7);
		background-size: 42px 42px, 42px 42px, auto;
		color: var(--ink, #160f0b);
		font-family: var(--body, "IBM Plex Sans", system-ui, sans-serif);
	}

	.detail-page *,
	.detail-page *::before,
	.detail-page *::after {
		box-sizing: border-box;
	}

	.detail-page.accent-lime { --accent-color: var(--lime, #b7ff4a); }
	.detail-page.accent-cyan { --accent-color: var(--cyan, #22d3c5); }
	.detail-page.accent-coral { --accent-color: var(--coral, #ff6247); }
	.detail-page.accent-violet { --accent-color: var(--violet, #6f5ae8); }
	.detail-page.accent-red { --accent-color: var(--red, #e53935); }

	.detail-main {
		position: relative;
		z-index: 1;
		width: min(860px, calc(100% - (var(--page-gutter) * 2)));
		margin-inline: auto;
		padding-block: clamp(28px, 5vw, 64px);
	}

	/* ── Header ── */

	.detail-header {
		padding-bottom: clamp(28px, 4vw, 48px);
		border-bottom: 2px solid var(--accent-color);
		margin-bottom: clamp(28px, 4vw, 48px);
	}

	.detail-eyebrow {
		margin: 0 0 16px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 5px 8px;
		color: var(--steel, #766a5e);
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.74rem;
		font-weight: 600;
	}

	.detail-eyebrow a {
		color: inherit;
		text-decoration: none;
		transition: color 150ms ease;
	}

	.detail-eyebrow a:hover {
		color: var(--ink, #160f0b);
	}

	.eyebrow-sep {
		user-select: none;
		opacity: 0.5;
	}

	.eyebrow-meta {
		opacity: 0.7;
	}

	h1 {
		margin: 0 0 16px;
		font-family: var(--display, "Bricolage Grotesque", sans-serif);
		font-size: clamp(2rem, 5vw, 3.2rem);
		font-weight: 800;
		line-height: 1.05;
	}

	.course-badges {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin-bottom: 18px;
	}

	.level-badge-prominent {
		display: inline-flex;
		align-items: center;
		padding: 5px 14px;
		background: var(--accent-color);
		color: var(--ink, #160f0b);
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		line-height: 1;
	}

	.meta-badge {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		padding: 5px 12px;
		border: 1px solid rgba(22, 15, 11, 0.18);
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--steel, #766a5e);
		line-height: 1;
	}

	.meta-badge--free {
		border-color: color-mix(in srgb, var(--lime, #b7ff4a) 50%, transparent);
		background: color-mix(in srgb, var(--lime, #b7ff4a) 12%, transparent);
		color: color-mix(in srgb, var(--lime, #b7ff4a) 30%, var(--ink, #160f0b));
	}

	.mec-badge {
		display: inline-flex;
		align-items: center;
		padding: 5px 12px;
		border: 1px solid color-mix(in srgb, var(--accent-color) 45%, transparent);
		background: color-mix(in srgb, var(--accent-color) 10%, transparent);
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.7rem;
		font-weight: 700;
		color: color-mix(in srgb, var(--accent-color) 70%, var(--ink, #160f0b));
		line-height: 1;
		letter-spacing: 0.03em;
	}

	.detail-description {
		margin: 0;
		max-width: 640px;
		color: var(--steel, #766a5e);
		line-height: 1.65;
		font-size: 1rem;
	}

	/* ── Body grid ── */

	.detail-body {
		display: grid;
		gap: clamp(28px, 4vw, 48px);
	}

	.detail-section {
		border-top: 1px solid rgba(22, 15, 11, 0.12);
		padding-top: clamp(20px, 3vw, 32px);
	}

	.section-label {
		margin: 0 0 16px;
		color: var(--steel, #766a5e);
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.74rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	/* ── Topics ── */

	.topic-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
	}

	.topic-chip {
		padding: 5px 12px;
		border: 1px solid rgba(22, 15, 11, 0.14);
		background: rgba(22, 15, 11, 0.025);
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.72rem;
		font-weight: 600;
		line-height: 1;
	}

	/* ── Apply CTA ── */

	.apply-section {
		border-top: 1px solid rgba(22, 15, 11, 0.12);
		padding-top: clamp(20px, 3vw, 32px);
	}

	.apply-btn {
		display: inline-block;
		padding: 14px 28px;
		background: var(--ink, #160f0b);
		color: var(--paper, #f8f1e7);
		font-family: var(--body, "IBM Plex Sans", system-ui, sans-serif);
		font-weight: 700;
		font-size: 0.95rem;
		text-decoration: none;
		letter-spacing: 0.01em;
		transition: background 200ms ease, color 200ms ease;
	}

	.apply-btn:hover {
		background: var(--accent-color);
		color: var(--ink, #160f0b);
	}

	/* ── Related courses ── */

	.related-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1px;
		background: rgba(22, 15, 11, 0.1);
		border: 1px solid rgba(22, 15, 11, 0.1);
		margin-bottom: 14px;
	}

	.related-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 16px 18px;
		color: inherit;
		text-decoration: none;
		background: var(--paper, #f8f1e7);
		transition: background 160ms ease;
	}

	.related-card:hover {
		background: color-mix(in srgb, var(--accent-color) 9%, var(--paper, #f8f1e7));
	}

	.related-card-inner {
		display: flex;
		flex-direction: column;
		gap: 6px;
		min-width: 0;
	}

	.related-name {
		font-weight: 700;
		font-size: 0.9rem;
		line-height: 1.3;
		transition: color 160ms ease;
	}

	.related-card:hover .related-name {
		color: color-mix(in srgb, var(--accent-color) 75%, var(--ink, #160f0b));
	}

	.level-badge {
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.58rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 2px 7px;
		border: 1px solid color-mix(in srgb, var(--accent-color) 45%, transparent);
		background: color-mix(in srgb, var(--accent-color) 10%, transparent);
		display: inline-block;
		align-self: flex-start;
		line-height: 1.6;
		white-space: nowrap;
	}

	.related-arrow {
		color: var(--steel, #766a5e);
		flex-shrink: 0;
		font-size: 1rem;
		transition: transform 160ms ease, color 160ms ease;
	}

	.related-card:hover .related-arrow {
		transform: translateX(4px);
		color: var(--accent-color);
	}

	.see-all-link {
		display: inline-block;
		font-size: 0.86rem;
		font-weight: 600;
		color: var(--steel, #766a5e);
		text-decoration: none;
		transition: color 150ms ease;
	}

	.see-all-link:hover {
		color: var(--ink, #160f0b);
	}

	/* ── Action CTA ── */

	.detail-action {
		border-top: 1px solid rgba(22, 15, 11, 0.12);
		padding-top: clamp(20px, 3vw, 32px);
	}

	.action-link {
		color: var(--steel, #766a5e);
		font-size: 0.88rem;
		font-weight: 600;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.action-link:hover {
		color: var(--ink, #160f0b);
	}

	@media (max-width: 500px) {
		.related-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
