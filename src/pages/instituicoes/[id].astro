---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";

export async function getStaticPaths() {
	const institutions = await getCollection("institutions", ({ data }) => !data.draft);
	const allCourses = await getCollection("courses", ({ data }) => !data.draft);

	return institutions.map((entry) => {
		const institutionCourses = allCourses.filter((course) =>
			course.id.startsWith(`${entry.id}/`),
		);
		return {
			params: { id: entry.id },
			props: { entry, courses: institutionCourses },
		};
	});
}

const { entry, courses } = Astro.props;
const { data } = entry;

// Group courses by level family
const LEVEL_GROUPS: Record<string, string[]> = {
	"Graduação": ["Bacharelado", "Tecnólogo", "Licenciatura"],
	"Pós-Graduação": ["Especialização", "MBA", "Mestrado", "Doutorado"],
	"Técnico": ["Técnico"],
};
const GROUP_ORDER = ["Graduação", "Técnico", "Pós-Graduação"];

const grouped = new Map<string, typeof courses>();
for (const course of courses) {
	let groupName = course.data.level;
	for (const [group, levels] of Object.entries(LEVEL_GROUPS)) {
		if (levels.some((l) => course.data.level.startsWith(l))) {
			groupName = group;
			break;
		}
	}
	if (!grouped.has(groupName)) grouped.set(groupName, []);
	grouped.get(groupName)!.push(course);
}

const courseGroups = [...grouped.entries()].sort(([a], [b]) => {
	const ai = GROUP_ORDER.indexOf(a);
	const bi = GROUP_ORDER.indexOf(b);
	if (ai === -1 && bi === -1) return a.localeCompare(b, "pt");
	if (ai === -1) return 1;
	if (bi === -1) return -1;
	return ai - bi;
});

// Synthesize tags into student-facing signals
const TAG_SIGNALS: Record<string, { icon: string; label: string }> = {
	"EAD": { icon: "◈", label: "EAD disponível" },
	"Público": { icon: "◉", label: "Ensino público" },
	"Pesquisa": { icon: "◈", label: "Foco em pesquisa" },
	"Federal": { icon: "◉", label: "Instituição pública" },
	"Estadual": { icon: "◉", label: "Instituição pública" },
	"Indústria": { icon: "◈", label: "Parceria com indústria" },
	"Extensão": { icon: "◈", label: "Projetos de extensão" },
};

const seenLabels = new Set<string>();
const characteristics: { icon: string; label: string }[] = [];
for (const tag of data.tags) {
	const signal = TAG_SIGNALS[tag];
	if (signal && !seenLabels.has(signal.label)) {
		seenLabels.add(signal.label);
		characteristics.push(signal);
	}
}

const githubIssueBaseUrl = "https://github.com/Jean-CS/rubra/issues/new";
const institutionIssueUrl = `${githubIssueBaseUrl}?template=indicar-instituicao.yml`;

const updateIssueUrl = new URL(institutionIssueUrl);
updateIssueUrl.searchParams.set("title", `Atualizar instituição: ${data.name}`);
updateIssueUrl.searchParams.set("request-type", "Atualização de instituição existente");
updateIssueUrl.searchParams.set("name", data.name);
updateIssueUrl.searchParams.set("website", data.website);
updateIssueUrl.searchParams.set("type", data.type);
updateIssueUrl.searchParams.set("profile", data.profile);
updateIssueUrl.searchParams.set("description", data.description);
updateIssueUrl.searchParams.set("tags", data.tags.join(", "));

const headerLinks = [
	{ href: "/comunidades", label: "Comunidades", accent: "lime" },
	{ href: "/instituicoes", label: "Ensino", accent: "cyan" },
	{ href: "/eventos", label: "Eventos", accent: "coral" },
	{ href: "/sobre", label: "Sobre", accent: "violet" },
	{ href: `${githubIssueBaseUrl}?template=indicar-instituicao.yml`, label: "Indicar", accent: "cyan" },
] as const;
---

<Layout
	title={`${data.name} | Instituição | Rubra`}
	description={data.description}
>
	<div class={`detail-page accent-${data.accent}`}>
		<SiteHeader links={headerLinks} />

		<main class="detail-main">
			<header class="detail-header">
				<p class="detail-eyebrow">
					<a href="/instituicoes">Ensino e formação</a>
				</p>
				<h1>{data.name}</h1>
				<p class="detail-description">{data.description}</p>
				<div class="meta-strip">
					<span class="meta-item">{data.type}</span>
					<span class="meta-sep" aria-hidden="true">·</span>
					<span class="meta-item">{data.profile}</span>
					<span class="meta-sep" aria-hidden="true">·</span>
					<a
						href={data.website}
						target="_blank"
						rel="noopener noreferrer"
						class="meta-link"
					>Site oficial →</a>
				</div>
			</header>

			<div class="detail-body">
				{courses.length > 0 && (
					<section class="courses-section" aria-labelledby="courses-title">
						<div class="section-header">
							<h2 id="courses-title" class="section-label">Cursos e programas</h2>
							<span class="course-count">
								{courses.length} {courses.length === 1 ? "curso" : "cursos"}
							</span>
						</div>
						<div class="course-groups">
							{courseGroups.map(([groupName, groupCourses]) => (
								<div class="course-group">
									{courseGroups.length > 1 && (
										<h3 class="group-heading">
											<span>{groupName}</span>
										</h3>
									)}
									<ul class="course-list" role="list">
										{groupCourses.map((course) => {
											const courseSlug = course.id.split("/")[1];
											return (
												<li>
													<a
														href={`/instituicoes/${entry.id}/${courseSlug}`}
														class="course-card"
													>
														<div class="course-card-inner">
															<div class="course-card-top">
																<span class="course-name">{course.data.name}</span>
																<span class="level-badge">{course.data.level}</span>
															</div>
															{course.data.description && (
																<p class="course-desc">{course.data.description}</p>
															)}
														</div>
														<span class="course-arrow" aria-hidden="true">→</span>
													</a>
												</li>
											);
										})}
									</ul>
								</div>
							))}
						</div>
					</section>
				)}

				{characteristics.length > 0 && (
					<section class="detail-section" aria-labelledby="char-title">
						<h2 id="char-title" class="section-label">Características</h2>
						<div class="characteristics">
							{characteristics.map(({ icon, label }) => (
								<div class="char-signal">
									<span class="char-icon" aria-hidden="true">{icon}</span>
									<span class="char-label">{label}</span>
								</div>
							))}
						</div>
					</section>
				)}

				{data.links && data.links.length > 0 && (
					<section class="detail-section" aria-labelledby="links-title">
						<h2 id="links-title" class="section-label">Links</h2>
						<div class="link-row">
							{data.links.map((link) => (
								<a
									href={link.url}
									target="_blank"
									rel="noopener noreferrer"
									class="detail-link"
								>
									{link.label} →
								</a>
							))}
						</div>
					</section>
				)}

				<div class="detail-action">
					<a href={updateIssueUrl.toString()} class="action-link">
						Atualizar dados desta instituição →
					</a>
				</div>
			</div>
		</main>

		<SiteFooter />
	</div>
</Layout>

<style>
	.detail-page {
		--page-gutter: clamp(18px, 3.8vw, 42px);
		--accent-color: var(--cyan, #22d3c5);
		position: relative;
		min-height: 100dvh;
		overflow-x: clip;
		background:
			linear-gradient(90deg, rgba(22, 15, 11, 0.055) 1px, transparent 1px),
			linear-gradient(rgba(22, 15, 11, 0.055) 1px, transparent 1px),
			var(--paper, #f8f1e7);
		background-size: 42px 42px, 42px 42px, auto;
		color: var(--ink, #160f0b);
		font-family: var(--body, "IBM Plex Sans", system-ui, sans-serif);
	}

	.detail-page *,
	.detail-page *::before,
	.detail-page *::after {
		box-sizing: border-box;
	}

	.detail-page.accent-lime { --accent-color: var(--lime, #b7ff4a); }
	.detail-page.accent-cyan { --accent-color: var(--cyan, #22d3c5); }
	.detail-page.accent-coral { --accent-color: var(--coral, #ff6247); }
	.detail-page.accent-violet { --accent-color: var(--violet, #6f5ae8); }
	.detail-page.accent-red { --accent-color: var(--red, #e53935); }

	.detail-main {
		position: relative;
		z-index: 1;
		width: min(860px, calc(100% - (var(--page-gutter) * 2)));
		margin-inline: auto;
		padding-block: clamp(28px, 5vw, 64px);
	}

	/* ── Header ── */

	.detail-header {
		padding-bottom: clamp(28px, 4vw, 48px);
		border-bottom: 2px solid var(--accent-color);
		margin-bottom: clamp(28px, 4vw, 48px);
	}

	.detail-eyebrow {
		margin: 0 0 16px;
		color: var(--steel, #766a5e);
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.74rem;
		font-weight: 600;
	}

	.detail-eyebrow a {
		color: inherit;
		text-decoration: none;
	}

	.detail-eyebrow a:hover {
		text-decoration: underline;
	}

	h1 {
		margin: 0 0 14px;
		font-family: var(--display, "Bricolage Grotesque", sans-serif);
		font-size: clamp(2rem, 5vw, 3.2rem);
		font-weight: 800;
		line-height: 1.05;
	}

	.detail-description {
		margin: 0 0 20px;
		max-width: 640px;
		color: var(--steel, #766a5e);
		line-height: 1.65;
		font-size: 1rem;
	}

	.meta-strip {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px 10px;
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.78rem;
		font-weight: 600;
	}

	.meta-item {
		color: var(--ink, #160f0b);
	}

	.meta-sep {
		color: var(--steel, #766a5e);
		user-select: none;
	}

	.meta-link {
		color: var(--accent-color);
		text-decoration: none;
		transition: opacity 150ms ease;
	}

	.meta-link:hover {
		opacity: 0.72;
		text-decoration: underline;
	}

	/* ── Body grid ── */

	.detail-body {
		display: grid;
		gap: clamp(28px, 4vw, 48px);
	}

	.detail-section {
		border-top: 1px solid rgba(22, 15, 11, 0.12);
		padding-top: clamp(20px, 3vw, 32px);
	}

	.section-label {
		margin: 0 0 16px;
		color: var(--steel, #766a5e);
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.74rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	/* ── Courses ── */

	.courses-section {
		border-top: 1px solid rgba(22, 15, 11, 0.12);
		padding-top: clamp(20px, 3vw, 32px);
	}

	.section-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 20px;
	}

	.section-header .section-label {
		margin-bottom: 0;
	}

	.course-count {
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.72rem;
		color: var(--steel, #766a5e);
		font-weight: 600;
		white-space: nowrap;
	}

	.course-groups {
		display: grid;
		gap: 28px;
	}

	.group-heading {
		margin: 0 0 10px;
		display: flex;
		align-items: center;
		gap: 10px;
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.68rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent-color);
	}

	.group-heading::after {
		content: "";
		flex: 1;
		height: 1px;
		background: color-mix(in srgb, var(--accent-color) 28%, transparent);
	}

	.course-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.course-card {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0 16px;
		align-items: center;
		padding: 15px 0;
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid rgba(22, 15, 11, 0.09);
		position: relative;
		padding-left: 0;
		transition: padding-left 200ms ease;
	}

	.course-card::before {
		content: "";
		position: absolute;
		inset-block: 0;
		left: -4px;
		width: 2px;
		background: var(--accent-color);
		opacity: 0;
		transition: opacity 200ms ease;
	}

	.course-card:hover {
		padding-left: 10px;
	}

	.course-card:hover::before {
		opacity: 1;
	}

	.course-card-inner {
		display: flex;
		flex-direction: column;
		gap: 5px;
		min-width: 0;
	}

	.course-card-top {
		display: flex;
		align-items: center;
		gap: 10px;
		flex-wrap: wrap;
	}

	.course-name {
		font-weight: 700;
		font-size: 0.97rem;
		line-height: 1.3;
		transition: color 200ms ease;
	}

	.course-card:hover .course-name {
		color: color-mix(in srgb, var(--accent-color) 75%, var(--ink, #160f0b));
	}

	.level-badge {
		font-family: var(--mono, "IBM Plex Mono", monospace);
		font-size: 0.6rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 2px 7px;
		border: 1px solid color-mix(in srgb, var(--accent-color) 45%, transparent);
		background: color-mix(in srgb, var(--accent-color) 10%, transparent);
		white-space: nowrap;
		flex-shrink: 0;
		line-height: 1.6;
	}

	.course-desc {
		margin: 0;
		font-size: 0.84rem;
		color: var(--steel, #766a5e);
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.course-arrow {
		color: var(--steel, #766a5e);
		transition: transform 200ms ease, color 200ms ease;
		font-size: 1rem;
		line-height: 1;
		flex-shrink: 0;
	}

	.course-card:hover .course-arrow {
		transform: translateX(4px);
		color: var(--accent-color);
	}

	/* ── Characteristics ── */

	.characteristics {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.char-signal {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		padding: 7px 14px;
		border: 1px solid rgba(22, 15, 11, 0.14);
		background: rgba(22, 15, 11, 0.025);
		font-size: 0.84rem;
		font-weight: 600;
		line-height: 1;
	}

	.char-icon {
		color: var(--accent-color);
		font-size: 0.72rem;
		line-height: 1;
	}

	/* ── Links ── */

	.link-row {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.detail-link {
		display: inline-block;
		padding: 8px 14px;
		border: 1px solid rgba(22, 15, 11, 0.2);
		color: inherit;
		font-size: 0.88rem;
		font-weight: 600;
		text-decoration: none;
		transition: border-color 160ms ease, background 160ms ease;
	}

	.detail-link:hover {
		border-color: var(--accent-color);
		background: color-mix(in srgb, var(--accent-color) 10%, transparent);
	}

	/* ── Action CTA ── */

	.detail-action {
		border-top: 1px solid rgba(22, 15, 11, 0.12);
		padding-top: clamp(20px, 3vw, 32px);
	}

	.action-link {
		color: var(--steel, #766a5e);
		font-size: 0.88rem;
		font-weight: 600;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.action-link:hover {
		color: var(--ink, #160f0b);
	}

	@media (max-width: 600px) {
		.section-header {
			flex-direction: column;
			gap: 2px;
			align-items: flex-start;
		}
	}
</style>
