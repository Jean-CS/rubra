---
import Layout from "../layouts/Layout.astro";

const communities = [
	{
		name: "GDG Londrina",
		type: "Developers",
		indexType: "DEV",
		description:
			"Comunidade local para pessoas que criam com Google technologies, web, cloud, mobile e práticas modernas de desenvolvimento.",
		cadence: "Meetups e eventos",
		status: "Ativa",
		accent: "red",
		tags: ["Web", "Cloud", "Android"],
	},
	{
		name: "Londrina Tech",
		type: "Ecossistema",
		indexType: "HUB",
		description:
			"Uma nova frente para conectar pessoas, empresas, eventos e iniciativas que fortalecem a cena de tecnologia da cidade.",
		cadence: "Em construção",
		status: "Nova",
		accent: "cyan",
		tags: ["Networking", "Eventos", "Startups"],
	},
	{
		name: "Redfoot",
		type: "Startups",
		indexType: "START",
		description:
			"Comunidade de startups do norte e noroeste do Paraná, também conhecida como Redfoot Brasil ou Redfoot Startup Community.",
		cadence: "Meetups e mentorias",
		status: "Ativa",
		accent: "coral",
		tags: ["Startups", "Inovação", "Meetups"],
	},
	{
		name: "Londrina AI",
		type: "Inteligência Artificial",
		indexType: "IA",
		description:
			"Espaço para explorar IA aplicada, agentes, automação, pesquisa, produtos e conversas técnicas sobre o que está surgindo.",
		cadence: "Encontros abertos",
		status: "Ativa",
		accent: "violet",
		tags: ["AI", "LLMs", "Automação"],
	},
	{
		name: "Londrina Hacker Club",
		type: "Hacker culture",
		indexType: "HACK",
		description:
			"Um ponto de encontro para segurança, cultura hacker, hardware, software livre, curiosidade técnica e experimentos práticos.",
		cadence: "Comunidade local",
		status: "Ativa",
		accent: "lime",
		tags: ["Security", "Hardware", "Labs"],
	},
];

const institutions = [
	{
		name: "SENAI",
		type: "Formação técnica",
		indexType: "TEC",
		description:
			"Formação técnica, cursos profissionalizantes e trilhas conectadas à indústria, automação, tecnologia e desenvolvimento de talentos.",
		profile: "Sistema S",
		accent: "lime",
		tags: ["Técnico", "Indústria", "Carreira"],
	},
	{
		name: "UTFPR",
		type: "Universidade",
		indexType: "PUB",
		description:
			"Instituição federal com presença em engenharia, computação, pesquisa aplicada e formação tecnológica no norte do Paraná.",
		profile: "Federal",
		accent: "cyan",
		tags: ["Federal", "Pesquisa", "Engenharia"],
	},
	{
		name: "IFPR",
		type: "Instituto",
		indexType: "IF",
		description:
			"Ensino técnico, superior e extensão pública, com potencial de conexão entre estudantes, tecnologia e iniciativas locais.",
		profile: "Federal",
		accent: "violet",
		tags: ["Público", "Técnico", "Extensão"],
	},
	{
		name: "UEL",
		type: "Universidade",
		indexType: "UNI",
		description:
			"Universidade estadual com Ciência da Computação no CCE, laboratórios, pesquisa, extensão e pós-graduação acadêmica na área.",
		profile: "Estadual",
		accent: "coral",
		tags: ["Estadual", "Pesquisa", "Extensão"],
	},
	{
		name: "Positivo",
		type: "Ensino superior",
		indexType: "UNI",
		description:
			"Instituição privada com cursos superiores, programas de formação e projetos aplicados em áreas conectadas à tecnologia.",
		profile: "Privada",
		accent: "cyan",
		tags: ["Privada", "Graduação", "Mercado"],
	},
	{
		name: "UNOPAR Anhanguera",
		type: "Ensino superior",
		indexType: "UNI",
		description:
			"Presença educacional ampla em Londrina, com cursos presenciais e digitais que alcançam muitos estudantes da região.",
		profile: "Privada",
		accent: "lime",
		tags: ["Graduação", "Digital", "Carreira"],
	},
	{
		name: "UniCesumar",
		type: "Ensino superior",
		indexType: "UNI",
		description:
			"Instituição com cursos superiores e formação continuada, conectando estudantes locais a trilhas profissionais e digitais.",
		profile: "Privada",
		accent: "coral",
		tags: ["Graduação", "EAD", "Profissional"],
	},
	{
		name: "UniFil",
		type: "Centro universitário",
		indexType: "UNI",
		description:
			"Centro universitário com histórico em cursos de tecnologia, incluindo Ciência da Computação, Engenharia de Software e ADS.",
		profile: "Privada",
		accent: "violet",
		tags: ["Local", "Graduação", "Projetos"],
	},
];

const ecosystemTracks = [
	{
		name: "Comunidades",
		indexType: "COM",
		accent: "lime",
		href: "#comunidades",
	},
	{
		name: "Instituições de Ensino",
		indexType: "EDU",
		accent: "cyan",
		href: "#instituicoes",
	},
	{
		name: "Eventos e sinais",
		indexType: "EVT",
		accent: "violet",
		href: "#sinais",
	},
	{
		name: "Novas iniciativas",
		indexType: "NEW",
		accent: "coral",
		href: "#indicar",
	},
];

const signals = [
	"Call for speakers",
	"Agenda compartilhada",
	"Novas comunidades",
	"Instituições de Ensino",
	"Meetups em Londrina",
	"Grupos para estudantes",
	"Eventos de IA",
];
---

<Layout>
	<main class="site-shell">
		<div class="viewport-stage">
			<nav class="nav" aria-label="Navegação principal">
				<a class="brand" href="/">
					<span class="brand-mark" aria-hidden="true">C</span>
					<span>Comunidades</span>
				</a>
				<div class="nav-links">
					<a href="#comunidades">Comunidades</a>
					<a href="#instituicoes">Ensino</a>
					<a href="#sinais">Sinais</a>
					<a href="#indicar">Indicar</a>
				</div>
			</nav>

			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy reveal">
					<p class="eyebrow">Londrina, PR · Hub tech local</p>
					<h1 id="hero-title">A cena tech de Londrina, em um só lugar.</h1>
					<p class="hero-lede">
						Encontre comunidades, Instituições de Ensino, eventos e pessoas de tecnologia,
						de GDG Londrina ao Londrina Hacker Club, UEL, UTFPR, SENAI e novas iniciativas
						surgindo pela cidade.
					</p>
					<div class="hero-actions">
						<a class="button button-primary" href="#comunidades">Explorar o mapa</a>
						<a class="button button-secondary" href="#indicar">Indicar iniciativa</a>
					</div>
					<div class="hero-strip" aria-label="Partes do ecossistema mapeadas">
						<span>Mapeando agora</span>
						<strong>Comunidades</strong>
						<strong>Instituições de Ensino</strong>
						<strong>Eventos</strong>
						<strong>Iniciativas</strong>
					</div>
				</div>

				<div class="index-panel reveal" aria-label="Prévia do mapa da cena tech de Londrina">
					<div class="panel-topline">
						<span>Diretório local</span>
						<span>23°18'S · 51°10'W</span>
					</div>
					<div class="index-board">
							<div class="index-stamp" aria-hidden="true">C</div>
							<div class="index-heading">
								<span>Ecossistema / Londrina</span>
								<strong>Índice da cena tech local.</strong>
							</div>
						<div class="index-list">
							{
								ecosystemTracks.map((track, index) => (
									<a class={`index-row accent-${track.accent}`} href={track.href}>
										<span class="index-number">{String(index + 1).padStart(2, "0")}</span>
										<strong>{track.name}</strong>
										<span class="index-type">{track.indexType}</span>
									</a>
								))
							}
						</div>
					</div>
					<div class="panel-footer">
						<span>{communities.length + institutions.length} entradas iniciais</span>
						<span>Aberto para novas indicações</span>
					</div>
				</div>
			</section>
		</div>

		<section class="metrics" aria-label="Resumo do projeto">
			<div>
				<strong>500k+</strong>
				<span>pessoas na cidade</span>
			</div>
			<div>
				<strong>{communities.length}</strong>
				<span>comunidades iniciais</span>
			</div>
			<div>
				<strong>8</strong>
				<span>Instituições de Ensino</span>
			</div>
		</section>

		<section class="section intro-section">
			<div class="section-kicker">Por que existe</div>
			<div class="intro-grid">
				<h2>A cena já existe. O problema é conseguir encontrá-la.</h2>
				<p>
					Comunidades nasce para transformar links soltos, grupos fechados, encontros
					espalhados e instituições difíceis de comparar em um mapa vivo da tecnologia em
					Londrina. Um hub simples para quem quer participar, organizar, aprender, palestrar
					ou só descobrir onde as coisas estão acontecendo.
				</p>
			</div>
		</section>

		<section class="section directory-section" id="comunidades" aria-labelledby="directory-title">
			<div class="section-heading">
				<div>
					<p class="section-kicker">Diretório inicial</p>
					<h2 id="directory-title">Comunidades em destaque</h2>
				</div>
				<p>
					Um primeiro mapa, feito para crescer com contribuições dos próprios organizadores.
				</p>
			</div>

			<div class="community-grid">
				{
					communities.map((community) => (
						<article class={`community-card accent-${community.accent}`}>
							<div class="card-header">
								<p>{community.type}</p>
								<span>{community.status}</span>
							</div>
							<h3>{community.name}</h3>
							<p>{community.description}</p>
							<div class="tag-row">
								{community.tags.map((tag) => (
									<span>{tag}</span>
								))}
							</div>
							<div class="card-footer">
								<span>{community.cadence}</span>
								<a href="#indicar" aria-label={`Atualizar dados de ${community.name}`}>
									Atualizar
								</a>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section class="section institution-section" id="instituicoes" aria-labelledby="institutions-title">
			<div class="section-heading">
				<div>
					<p class="section-kicker">Instituições de Ensino</p>
					<h2 id="institutions-title">Onde a formação tech também acontece.</h2>
				</div>
				<p>
					Universidades, institutos e centros de formação entram no mapa porque também
					abrem portas para estudantes, projetos, pesquisa, eventos e primeiras conexões
					com a cena local.
				</p>
			</div>

			<div class="community-grid institution-grid">
				{
					institutions.map((institution) => (
							<article class={`community-card institution-card accent-${institution.accent}`}>
								<div class="card-header">
									<p>{institution.type}</p>
									{institution.profile && <span>{institution.profile}</span>}
								</div>
							<h3>{institution.name}</h3>
							<p>{institution.description}</p>
							<div class="tag-row">
								{institution.tags.map((tag) => (
									<span>{tag}</span>
								))}
							</div>
							<div class="card-footer">
								<span>{institution.indexType}</span>
								<a href="#indicar" aria-label={`Atualizar dados de ${institution.name}`}>
									Atualizar
								</a>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section class="signal-section" id="sinais" aria-labelledby="signals-title">
			<div class="signal-copy">
				<p class="section-kicker">Sinais da cidade</p>
				<h2 id="signals-title">Um radar para o que está acontecendo agora.</h2>
			</div>
			<div class="signal-board" aria-label="Sinais do ecossistema">
				{
					signals.map((signal, index) => (
						<span style={`--delay: ${index * 0.12}s`}>{signal}</span>
					))
				}
			</div>
		</section>

		<section class="section submit-section" id="indicar" aria-labelledby="submit-title">
			<div class="submit-card">
				<p class="section-kicker">Aprovação editorial</p>
				<h2 id="submit-title">Conhece uma comunidade ou Instituição de Ensino que deveria estar aqui?</h2>
				<p>
					As indicações entram por dois caminhos e passam por revisão antes de aparecer no
					site. A ideia é manter o mapa aberto para a cidade, mas curado o suficiente para
					continuar confiável.
				</p>
				<div class="submit-flow" aria-label="Opções de indicação">
					<p>
						<strong>Comunidade</strong>
						<span>Para grupos, meetups, coletivos, labs e iniciativas recorrentes.</span>
					</p>
					<p>
						<strong>Instituição de Ensino</strong>
						<span>Para universidades, institutos, centros de formação e cursos relevantes.</span>
					</p>
				</div>
				<div class="submit-actions">
					<a class="button button-primary" href="mailto:hello@comunidades.dev?subject=Indicar comunidade">
						Indicar comunidade
					</a>
					<a class="button button-secondary" href="mailto:hello@comunidades.dev?subject=Indicar Instituicao de Ensino">
						Indicar Instituição de Ensino
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	:root {
		--ink: #08110f;
		--paper: #f7f5ef;
		--mist: #e8ece5;
		--lime: #b7ff4a;
		--cyan: #22d3c5;
		--coral: #ff6247;
		--red: #e53935;
		--violet: #7357ff;
		--steel: #69746f;
		--line: rgba(8, 17, 15, 0.14);
		--shadow: 0 28px 80px rgba(8, 17, 15, 0.14);
		--display: "Bricolage Grotesque", "IBM Plex Sans", sans-serif;
		--body: "IBM Plex Sans", system-ui, sans-serif;
		--mono: "IBM Plex Mono", ui-monospace, monospace;
	}

	.site-shell {
		--page-gutter: clamp(18px, 3.8vw, 40px);
		position: relative;
		min-height: 100svh;
		min-height: 100dvh;
		overflow-x: clip;
		background:
			radial-gradient(circle at 16% 8%, rgba(183, 255, 74, 0.32), transparent 26rem),
			radial-gradient(circle at 84% 10%, rgba(34, 211, 197, 0.26), transparent 24rem),
			linear-gradient(120deg, rgba(255, 98, 71, 0.08), transparent 28rem),
			var(--paper);
	}

	.viewport-stage {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-rows: auto minmax(0, 1fr);
		min-height: 100svh;
		min-height: 100dvh;
	}

	.site-shell::before {
		position: absolute;
		inset: 0;
		pointer-events: none;
		content: "";
		background-image:
			linear-gradient(rgba(8, 17, 15, 0.055) 1px, transparent 1px),
			linear-gradient(90deg, rgba(8, 17, 15, 0.055) 1px, transparent 1px);
		background-size: 42px 42px;
		mask-image: linear-gradient(to bottom, #000 0%, transparent 72%);
	}

	.site-shell::after {
		position: absolute;
		inset: 0;
		pointer-events: none;
		content: "";
		opacity: 0.34;
		background-image:
			linear-gradient(115deg, transparent 0 44%, rgba(8, 17, 15, 0.08) 44% 44.3%, transparent 44.3%),
			linear-gradient(25deg, transparent 0 72%, rgba(8, 17, 15, 0.06) 72% 72.2%, transparent 72.2%);
	}

	.nav,
	.hero,
	.metrics,
	.section,
	.signal-section {
		position: relative;
		z-index: 1;
		width: min(1180px, calc(100% - (var(--page-gutter) * 2)));
		margin-inline: auto;
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: clamp(64px, 8dvh, 84px);
		padding: clamp(14px, 2dvh, 24px) 0;
	}

	.brand,
	.nav-links {
		display: flex;
		align-items: center;
	}

	.brand {
		gap: 10px;
		font-family: var(--display);
		font-size: 1.04rem;
		font-weight: 800;
		text-decoration: none;
	}

	.brand-mark {
		display: grid;
		width: 34px;
		height: 34px;
		place-items: center;
		border: 1px solid var(--ink);
		background: var(--lime);
		box-shadow: 4px 4px 0 var(--ink);
		font-family: var(--mono);
		font-size: 0.85rem;
	}

	.nav-links {
		gap: 8px;
		padding: 6px;
		border: 1px solid var(--line);
		background: rgba(247, 245, 239, 0.72);
		backdrop-filter: blur(16px);
	}

	.nav-links a {
		padding: 10px 12px;
		color: var(--steel);
		font-size: 0.88rem;
		font-weight: 700;
		text-decoration: none;
		transition: color 180ms ease, background 180ms ease;
	}

	.nav-links a:hover {
		background: var(--ink);
		color: var(--paper);
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(360px, 0.78fr);
		gap: clamp(30px, 4.8vw, 78px);
		align-items: center;
		min-height: 0;
		padding: clamp(12px, 2.2dvh, 28px) 0 clamp(22px, 4.8dvh, 54px);
	}

	.hero-copy {
		max-width: 780px;
	}

	.eyebrow,
	.section-kicker {
		margin: 0 0 clamp(12px, 1.8dvh, 18px);
		color: var(--steel);
		font-family: var(--mono);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1,
	h2,
	h3 {
		font-family: var(--display);
		letter-spacing: 0;
	}

	h1 {
		max-width: 790px;
		margin-bottom: clamp(15px, 2.4dvh, 24px);
		font-size: clamp(3.65rem, min(7.2vw, 11.5dvh), 7.25rem);
		font-weight: 800;
		line-height: 0.88;
	}

	.hero-lede {
		max-width: 640px;
		margin-bottom: clamp(18px, 2.6dvh, 26px);
		color: #31403a;
		font-size: clamp(1rem, min(1.55vw, 2.3dvh), 1.24rem);
		line-height: 1.56;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.hero-strip {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		align-items: center;
		max-width: 660px;
		margin-top: clamp(18px, 2.8dvh, 28px);
	}

	.hero-strip span,
	.hero-strip strong {
		display: inline-flex;
		align-items: center;
		min-height: 34px;
		padding: 0 10px;
		border: 1px solid var(--line);
		background: rgba(247, 245, 239, 0.72);
		font-family: var(--mono);
		font-size: 0.68rem;
		font-weight: 600;
		text-transform: uppercase;
	}

	.hero-strip span {
		border-color: var(--ink);
		background: var(--ink);
		color: var(--paper);
	}

	.hero-strip strong:nth-of-type(1) {
		box-shadow: inset 0 4px 0 var(--lime);
	}

	.hero-strip strong:nth-of-type(2) {
		box-shadow: inset 0 4px 0 var(--cyan);
	}

	.hero-strip strong:nth-of-type(3) {
		box-shadow: inset 0 4px 0 var(--violet);
	}

	.hero-strip strong:nth-of-type(4) {
		box-shadow: inset 0 4px 0 var(--coral);
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		padding: 0 18px;
		border: 1px solid var(--ink);
		font-weight: 800;
		text-decoration: none;
		transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
	}

	.button:hover {
		transform: translateY(-2px);
	}

	.button-primary {
		background: var(--lime);
		box-shadow: 5px 5px 0 var(--ink);
		color: var(--ink);
	}

	.button-primary:hover {
		box-shadow: 7px 7px 0 var(--ink);
	}

	.button-secondary {
		background: rgba(247, 245, 239, 0.72);
		color: var(--ink);
	}

	.button-secondary:hover {
		background: var(--ink);
		color: var(--paper);
	}

	.index-panel {
		position: relative;
		align-self: center;
		height: clamp(380px, 62dvh, 620px);
		min-height: 0;
		border: 1px solid rgba(8, 17, 15, 0.24);
		background:
			linear-gradient(135deg, rgba(8, 17, 15, 0.97), rgba(17, 25, 22, 0.94)),
			var(--ink);
		box-shadow: var(--shadow);
		color: var(--paper);
		overflow: hidden;
		transform: translateY(-8px);
	}

	.index-panel::before {
		position: absolute;
		inset: 0;
		content: "";
		background-image:
			linear-gradient(rgba(247, 245, 239, 0.08) 1px, transparent 1px),
			linear-gradient(90deg, rgba(247, 245, 239, 0.08) 1px, transparent 1px);
		background-size: 36px 36px;
		mask-image: linear-gradient(to bottom, #000, transparent 88%);
	}

	.index-panel::after {
		position: absolute;
		inset: auto -12% -24% 22%;
		height: 280px;
		content: "";
		background: radial-gradient(circle, rgba(34, 211, 197, 0.42), transparent 68%);
		filter: blur(10px);
	}

