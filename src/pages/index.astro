		border: 1px solid var(--line);
		background: rgba(255, 255, 255, 0.34);
		color: #4a3c31;
	}

	.card-footer {
		margin-top: 20px;
		padding-top: 16px;
		border-top: 1px solid var(--line);
		color: var(--steel);
	}

	.card-actions {
		display: inline-flex;
		align-items: center;
		gap: 10px;
	}

	.card-footer a {
		color: color-mix(in srgb, var(--steel) 82%, transparent);
		font-size: 0.62rem;
		font-weight: 600;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		transition: color 160ms ease, opacity 160ms ease;
	}

	.card-footer a:hover {
		color: var(--ink);
	}

	.card-footer .website-link {
		display: inline-grid;
		width: 34px;
		height: 34px;
		place-items: center;
		border: 1px solid transparent;
		background: transparent;
		color: color-mix(in srgb, var(--steel) 82%, transparent);
		text-decoration: none;
		transition: transform 160ms ease, background 160ms ease, border-color 160ms ease;
	}

	.card-footer .website-link:hover,
	.card-footer .website-link:focus-visible {
		border-color: color-mix(in srgb, var(--accent) 68%, var(--ink));
		background: rgba(255, 255, 255, 0.36);
		transform: translateY(-1px);
	}

	.card-footer .website-link:active {
		border-color: var(--ink);
		background: var(--accent);
		transform: translateY(0);
	}

	.website-link svg {
		width: 17px;
		height: 17px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.9;
	}

	.event-section {
		display: grid;
		grid-template-columns: minmax(430px, 0.36fr) minmax(0, 1fr);
		gap: clamp(36px, 6vw, 88px);
		align-items: start;
		padding-top: 110px;
	}

	.event-copy {
		position: relative;
		z-index: 2;
		min-width: 0;
	}

	.event-copy h2 {
		max-width: 9ch;
		margin-bottom: 18px;
		font-size: clamp(2.8rem, 4.8vw, 5.1rem);
		overflow-wrap: normal;
		text-wrap: balance;
	}

	.event-copy p:not(.section-kicker) {
		max-width: 420px;
		margin: 0 0 22px;
		color: #4a3c31;
		font-size: 1.02rem;
		line-height: 1.62;
		text-wrap: pretty;
	}

	.event-copy-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.event-board {
		position: relative;
		display: grid;
		gap: 14px;
		min-height: 0;
		margin-top: clamp(28px, 4vw, 62px);
		padding: clamp(20px, 3vw, 30px) 0 0;
	}

	.event-card {
		position: relative;
		display: grid;
		grid-template-columns: minmax(96px, 0.22fr) minmax(0, 1fr);
		gap: clamp(16px, 2.4vw, 28px);
		padding: clamp(18px, 2.6vw, 26px);
		border: 1px solid var(--line);
		background: rgba(248, 241, 231, 0.82);
		color: var(--ink);
		backdrop-filter: blur(18px);
		animation: signal-rise 700ms ease both;
		animation-delay: var(--delay);
	}

	.event-card::before {
		position: absolute;
		inset: 0 0 auto;
		height: 5px;
		content: "";
		background: var(--violet);
	}

	.event-date {
		display: grid;
		align-content: start;
		gap: 7px;
		min-width: 0;
	}

	.event-date strong {
		font-family: var(--display);
		font-size: clamp(1.7rem, 2.6vw, 2.55rem);
		font-weight: 800;
		line-height: 0.95;
		text-transform: lowercase;
	}

	.event-date span,
	.event-meta span,
	.event-footer > span {
		color: var(--steel);
		font-family: var(--mono);
		font-size: 0.68rem;
		font-weight: 600;
		text-transform: uppercase;
	}

	.event-body h3 {
		margin-bottom: 12px;
		font-size: clamp(1.55rem, 2.2vw, 2.1rem);
		font-weight: 800;
		line-height: 1;
	}

	.event-body h3 a {
		text-decoration: none;
	}

	.event-body h3 a:hover {
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}

	.event-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
		margin-bottom: 14px;
	}

	.event-meta span {
		padding: 6px 8px;
		border: 1px solid var(--line);
		background: rgba(255, 255, 255, 0.34);
		color: #4a3c31;
	}

	.event-footer {
		display: grid;
		gap: 10px;
		margin-top: 18px;
	}

	.event-tags {
		margin-top: 0;
		padding-top: 0;
	}

	.event-archive-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 14px;
		padding: 16px 18px;
		border: 1px solid var(--ink);
		background: var(--ink);
		box-shadow: 5px 5px 0 var(--cyan);
		color: var(--paper);
	}

	.event-archive-link span,
	.event-archive-link a {
		font-family: var(--mono);
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.event-archive-link a {
		color: var(--lime);
		text-underline-offset: 4px;
	}

	.empty-events {
		padding: clamp(24px, 4vw, 38px);
		border: 1px solid var(--ink);
		background: var(--lime);
		box-shadow: 5px 5px 0 var(--ink);
	}

	.empty-events strong {
		display: block;
		margin-bottom: 10px;
		font-family: var(--display);
		font-size: clamp(1.8rem, 3vw, 2.55rem);
		line-height: 0.98;
	}

	.submit-section {
		position: relative;
		padding-bottom: 92px;
	}

	.anchor-alias {
		position: absolute;
		inset-block-start: 0;
	}

	.submit-card {
		position: relative;
		max-width: 850px;
		padding: clamp(28px, 5vw, 54px);
		border: 1px solid var(--ink);
		background:
			linear-gradient(120deg, rgba(248, 241, 231, 0.92), rgba(234, 223, 206, 0.86)),
			var(--mist);
		box-shadow: 7px 7px 0 var(--ink);
	}

	.submit-card::after {
		position: absolute;
		top: -18px;
		right: -18px;
		width: 88px;
		height: 88px;
		border: 1px solid var(--ink);
		content: "";
		background:
			linear-gradient(90deg, transparent 46%, var(--ink) 46% 48%, transparent 48%),
			linear-gradient(transparent 46%, var(--ink) 46% 48%, transparent 48%),
			var(--lime);
		box-shadow: 5px 5px 0 var(--ink);
	}

	.submit-card h2 {
		margin-bottom: 18px;
		font-size: clamp(2.3rem, 5vw, 4.8rem);
	}

	.submit-card p {
		max-width: 660px;
		margin-bottom: 28px;
	}

	.submit-flow {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
		max-width: 820px;
		margin: 0 0 24px;
		padding-top: 6px;
	}

	.submit-flow p {
		display: grid;
		gap: 8px;
		margin: 0;
		padding-top: 16px;
		border-top: 1px solid var(--line);
	}

	.submit-flow strong {
		font-family: var(--display);
		font-size: 1.18rem;
		line-height: 1;
	}

	.submit-flow span {
		display: block;
		font-size: 0.96rem;
		line-height: 1.5;
	}

	.submit-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.reveal {
		animation: reveal-up 720ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.index-panel.reveal {
		animation-delay: 140ms;
	}

	@keyframes reveal-up {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes signal-rise {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-height: 820px) and (min-width: 1021px) {
		.hero {
			gap: clamp(24px, 4vw, 58px);
			padding-bottom: clamp(16px, 3dvh, 36px);
		}

		h1 {
			font-size: clamp(3.25rem, min(6.4vw, 9.4dvh), 6.25rem);
			line-height: 0.93;
		}

		.hero-lede {
			max-width: 610px;
			line-height: 1.48;
		}

		.hero-strip {
			display: none;
		}

		.index-panel {
			height: clamp(330px, 57dvh, 500px);
		}

		.index-board {
			inset-block: 62px 76px;
			gap: 14px;
		}

		.index-heading strong {
			font-size: clamp(1.45rem, min(2.35vw, 4dvh), 2.15rem);
		}

		.index-list {
			gap: 8px;
		}

		.index-type {
			min-height: 28px;
		}
	}

	@media (max-width: 1020px) {
		.hero,
		.positioning-section,
		.section-heading,
		.event-section {
			grid-template-columns: 1fr;
		}

		.hero {
			align-content: start;
			min-height: 0;
			padding-top: clamp(28px, 5dvh, 54px);
		}

		.index-panel {
			width: min(100%, 640px);
			height: clamp(320px, 44dvh, 500px);
			transform: none;
		}

		.community-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.metrics {
			grid-template-columns: repeat(2, minmax(0, 1fr));
