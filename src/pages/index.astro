---
import Layout from "../layouts/Layout.astro";

const communities = [
	{
		name: "GDG Londrina",
		type: "Developers",
		description:
			"Comunidade local para pessoas que criam com Google technologies, web, cloud, mobile e práticas modernas de desenvolvimento.",
		cadence: "Meetups e eventos",
		status: "Ativa",
		accent: "lime",
		tags: ["Web", "Cloud", "Android"],
	},
	{
		name: "Londrina Tech",
		type: "Ecossistema",
		description:
			"Uma nova frente para conectar pessoas, empresas, eventos e iniciativas que fortalecem a cena de tecnologia da cidade.",
		cadence: "Em construção",
		status: "Nova",
		accent: "cyan",
		tags: ["Networking", "Eventos", "Startups"],
	},
	{
		name: "Londrina AI",
		type: "Inteligência Artificial",
		description:
			"Espaço para explorar IA aplicada, agentes, automação, pesquisa, produtos e conversas técnicas sobre o que está surgindo.",
		cadence: "Encontros abertos",
		status: "Ativa",
		accent: "violet",
		tags: ["AI", "LLMs", "Automação"],
	},
	{
		name: "Londrina Hacker Club",
		type: "Hacker culture",
		description:
			"Um ponto de encontro para segurança, cultura hacker, hardware, software livre, curiosidade técnica e experimentos práticos.",
		cadence: "Comunidade local",
		status: "Ativa",
		accent: "coral",
		tags: ["Security", "Hardware", "Labs"],
	},
];

const signals = [
	"Call for speakers",
	"Agenda compartilhada",
	"Novas comunidades",
	"Meetups em Londrina",
	"Grupos para estudantes",
	"Eventos de IA",
];
---

<Layout>
	<main class="site-shell">
		<nav class="nav" aria-label="Navegação principal">
			<a class="brand" href="/">
				<span class="brand-mark" aria-hidden="true">C</span>
				<span>Comunidades</span>
			</a>
			<div class="nav-links">
				<a href="#comunidades">Comunidades</a>
				<a href="#sinais">Sinais</a>
				<a href="#indicar">Indicar</a>
			</div>
		</nav>

		<section class="hero" aria-labelledby="hero-title">
			<div class="hero-copy reveal">
				<p class="eyebrow">Londrina, PR · Hub tech local</p>
				<h1 id="hero-title">A cena tech de Londrina, em um só lugar.</h1>
				<p class="hero-lede">
					Encontre grupos, eventos e pessoas de tecnologia em um só lugar, de GDG
					Londrina ao Londrina Hacker Club, comunidades de IA e novas iniciativas surgindo
					pela cidade.
				</p>
				<div class="hero-actions">
					<a class="button button-primary" href="#comunidades">Explorar comunidades</a>
					<a class="button button-secondary" href="#indicar">Indicar uma comunidade</a>
				</div>
				<div class="hero-strip" aria-label="Comunidades mapeadas">
					<span>Mapeando agora</span>
					<strong>GDG Londrina</strong>
					<strong>Londrina Tech</strong>
					<strong>Londrina AI</strong>
					<strong>Londrina Hacker Club</strong>
				</div>
			</div>

			<div class="network-panel reveal" aria-label="Mapa visual das comunidades tech de Londrina">
				<div class="panel-topline">
					<span>Tech map</span>
					<span>23°18'S · 51°10'W</span>
				</div>
				<div class="network-map" aria-hidden="true">
					<div class="route route-a"></div>
					<div class="route route-b"></div>
					<div class="route route-c"></div>
					<div class="node node-main">
						<span>Comunidades</span>
					</div>
					<div class="node node-gdg">
						<strong>GDG</strong>
						<small>dev</small>
					</div>
					<div class="node node-tech">
						<strong>L.Tech</strong>
						<small>hub</small>
					</div>
					<div class="node node-ai">
						<strong>AI</strong>
						<small>labs</small>
					</div>
					<div class="node node-hacker">
						<strong>LHC</strong>
						<small>hack</small>
					</div>
					<div class="pulse-dot dot-one"></div>
					<div class="pulse-dot dot-two"></div>
					<div class="pulse-dot dot-three"></div>
				</div>
				<div class="panel-footer">
					<span>4 comunidades mapeadas</span>
					<span>Aberto para organizadores</span>
				</div>
			</div>
		</section>

		<section class="metrics" aria-label="Resumo do projeto">
			<div>
				<strong>500k+</strong>
				<span>pessoas na cidade</span>
			</div>
			<div>
				<strong>4</strong>
				<span>comunidades iniciais</span>
			</div>
			<div>
				<strong>1</strong>
				<span>lugar para descobrir tudo</span>
			</div>
		</section>

		<section class="section intro-section">
			<div class="section-kicker">Por que existe</div>
			<div class="intro-grid">
				<h2>A cena já existe. O problema é conseguir encontrá-la.</h2>
				<p>
					Comunidades nasce para transformar links soltos, grupos fechados e encontros
					espalhados em um mapa vivo da tecnologia em Londrina. Um hub simples para quem
					quer participar, organizar, aprender, palestrar ou só descobrir onde as coisas
					estão acontecendo.
				</p>
			</div>
		</section>

		<section class="section directory-section" id="comunidades" aria-labelledby="directory-title">
			<div class="section-heading">
				<div>
					<p class="section-kicker">Diretório inicial</p>
					<h2 id="directory-title">Comunidades em destaque</h2>
				</div>
				<p>
					Um primeiro mapa, feito para crescer com contribuições dos próprios organizadores.
				</p>
			</div>

			<div class="community-grid">
				{
					communities.map((community) => (
						<article class={`community-card accent-${community.accent}`}>
							<div class="card-header">
								<p>{community.type}</p>
								<span>{community.status}</span>
							</div>
							<h3>{community.name}</h3>
							<p>{community.description}</p>
							<div class="tag-row">
								{community.tags.map((tag) => (
									<span>{tag}</span>
								))}
							</div>
							<div class="card-footer">
								<span>{community.cadence}</span>
								<a href="#indicar" aria-label={`Atualizar dados de ${community.name}`}>
									Atualizar
								</a>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section class="signal-section" id="sinais" aria-labelledby="signals-title">
			<div class="signal-copy">
				<p class="section-kicker">Sinais da cidade</p>
				<h2 id="signals-title">Um radar para o que está acontecendo agora.</h2>
			</div>
			<div class="signal-board" aria-label="Sinais do ecossistema">
				{
					signals.map((signal, index) => (
						<span style={`--delay: ${index * 0.12}s`}>{signal}</span>
					))
				}
			</div>
		</section>

		<section class="section submit-section" id="indicar" aria-labelledby="submit-title">
			<div class="submit-card">
				<p class="section-kicker">Aberto para organizadores</p>
				<h2 id="submit-title">Conhece uma comunidade que deveria estar aqui?</h2>
				<p>
					O próximo passo é abrir um fluxo simples para indicar comunidades, corrigir
					informações e divulgar próximos encontros. Por enquanto, esta página valida a
					ideia e o visual do hub.
				</p>
				<a class="button button-primary" href="mailto:hello@comunidades.dev?subject=Indicar comunidade">
					Indicar comunidade
				</a>
			</div>
		</section>
	</main>
</Layout>

<style>
	:root {
		--ink: #08110f;
		--paper: #f7f5ef;
		--mist: #e8ece5;
		--lime: #b7ff4a;
		--cyan: #22d3c5;
		--coral: #ff6247;
		--violet: #7357ff;
		--steel: #69746f;
		--line: rgba(8, 17, 15, 0.14);
		--shadow: 0 28px 80px rgba(8, 17, 15, 0.14);
		--display: "Bricolage Grotesque", "IBM Plex Sans", sans-serif;
		--body: "IBM Plex Sans", system-ui, sans-serif;
		--mono: "IBM Plex Mono", ui-monospace, monospace;
	}

	.site-shell {
		position: relative;
		overflow: hidden;
		min-height: 100vh;
		background:
			radial-gradient(circle at 16% 8%, rgba(183, 255, 74, 0.32), transparent 26rem),
			radial-gradient(circle at 84% 10%, rgba(34, 211, 197, 0.26), transparent 24rem),
			linear-gradient(120deg, rgba(255, 98, 71, 0.08), transparent 28rem),
			var(--paper);
	}

	.site-shell::before {
		position: absolute;
		inset: 0;
		pointer-events: none;
		content: "";
		background-image:
			linear-gradient(rgba(8, 17, 15, 0.055) 1px, transparent 1px),
			linear-gradient(90deg, rgba(8, 17, 15, 0.055) 1px, transparent 1px);
		background-size: 42px 42px;
		mask-image: linear-gradient(to bottom, #000 0%, transparent 72%);
	}

	.site-shell::after {
		position: absolute;
		inset: 0;
		pointer-events: none;
		content: "";
		opacity: 0.34;
		background-image:
			linear-gradient(115deg, transparent 0 44%, rgba(8, 17, 15, 0.08) 44% 44.3%, transparent 44.3%),
			linear-gradient(25deg, transparent 0 72%, rgba(8, 17, 15, 0.06) 72% 72.2%, transparent 72.2%);
	}

	.nav,
	.hero,
	.metrics,
	.section,
	.signal-section {
		position: relative;
		z-index: 1;
		width: min(1180px, calc(100% - 40px));
		margin-inline: auto;
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 24px 0;
	}

	.brand,
	.nav-links {
		display: flex;
		align-items: center;
	}

	.brand {
		gap: 10px;
		font-family: var(--display);
		font-size: 1.04rem;
		font-weight: 800;
		text-decoration: none;
	}

	.brand-mark {
		display: grid;
		width: 34px;
		height: 34px;
		place-items: center;
		border: 1px solid var(--ink);
		background: var(--lime);
		box-shadow: 4px 4px 0 var(--ink);
		font-family: var(--mono);
		font-size: 0.85rem;
	}

	.nav-links {
		gap: 8px;
		padding: 6px;
		border: 1px solid var(--line);
		background: rgba(247, 245, 239, 0.72);
		backdrop-filter: blur(16px);
	}

	.nav-links a {
		padding: 10px 12px;
		color: var(--steel);
		font-size: 0.88rem;
		font-weight: 700;
		text-decoration: none;
		transition: color 180ms ease, background 180ms ease;
	}

	.nav-links a:hover {
		background: var(--ink);
		color: var(--paper);
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(430px, 0.82fr);
		gap: clamp(34px, 5vw, 86px);
		align-items: center;
		min-height: calc(100vh - 118px);
		padding: 28px 0 64px;
	}

	.hero-copy {
		max-width: 780px;
	}

	.eyebrow,
	.section-kicker {
		margin: 0 0 18px;
		color: var(--steel);
		font-family: var(--mono);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1,
	h2,
	h3 {
		font-family: var(--display);
		letter-spacing: 0;
	}

	h1 {
		max-width: 790px;
		margin-bottom: 24px;
		font-size: clamp(4.25rem, 7.6vw, 7.6rem);
		font-weight: 800;
		line-height: 0.88;
	}

	.hero-lede {
		max-width: 640px;
		margin-bottom: 26px;
		color: #31403a;
		font-size: clamp(1.08rem, 1.7vw, 1.28rem);
		line-height: 1.62;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.hero-strip {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		align-items: center;
		max-width: 660px;
		margin-top: 28px;
	}

	.hero-strip span,
	.hero-strip strong {
		display: inline-flex;
		align-items: center;
		min-height: 34px;
		padding: 0 10px;
		border: 1px solid var(--line);
		background: rgba(247, 245, 239, 0.72);
		font-family: var(--mono);
		font-size: 0.68rem;
		font-weight: 600;
		text-transform: uppercase;
	}

	.hero-strip span {
		border-color: var(--ink);
		background: var(--ink);
		color: var(--paper);
	}

	.hero-strip strong:nth-of-type(1) {
		box-shadow: inset 0 4px 0 var(--lime);
	}

	.hero-strip strong:nth-of-type(2) {
		box-shadow: inset 0 4px 0 var(--cyan);
	}

	.hero-strip strong:nth-of-type(3) {
		box-shadow: inset 0 4px 0 var(--violet);
	}

	.hero-strip strong:nth-of-type(4) {
		box-shadow: inset 0 4px 0 var(--coral);
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		padding: 0 18px;
		border: 1px solid var(--ink);
		font-weight: 800;
		text-decoration: none;
		transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
	}

	.button:hover {
		transform: translateY(-2px);
	}

	.button-primary {
		background: var(--lime);
		box-shadow: 5px 5px 0 var(--ink);
		color: var(--ink);
	}

	.button-primary:hover {
		box-shadow: 7px 7px 0 var(--ink);
	}

	.button-secondary {
		background: rgba(247, 245, 239, 0.72);
		color: var(--ink);
	}

	.button-secondary:hover {
		background: var(--ink);
		color: var(--paper);
	}

	.network-panel {
		position: relative;
		align-self: center;
		min-height: min(620px, calc(100vh - 190px));
		border: 1px solid rgba(8, 17, 15, 0.24);
		background:
			linear-gradient(135deg, rgba(8, 17, 15, 0.96), rgba(20, 31, 27, 0.92)),
			var(--ink);
		box-shadow: var(--shadow);
		color: var(--paper);
		overflow: hidden;
		transform: translateY(-8px);
	}

	.network-panel::before {
		position: absolute;
		inset: 0;
		content: "";
		background-image:
			linear-gradient(rgba(247, 245, 239, 0.08) 1px, transparent 1px),
			linear-gradient(90deg, rgba(247, 245, 239, 0.08) 1px, transparent 1px);
		background-size: 36px 36px;
		mask-image: radial-gradient(circle at 50% 44%, #000 0 44%, transparent 72%);
	}

	.network-panel::after {
		position: absolute;
		inset: auto -8% -20% 12%;
		height: 260px;
		content: "";
		background: radial-gradient(circle, rgba(34, 211, 197, 0.42), transparent 68%);
		filter: blur(10px);
	}

	.panel-topline,
	.panel-footer {
		position: absolute;
		z-index: 2;
		right: 22px;
		left: 22px;
		display: flex;
		justify-content: space-between;
		gap: 20px;
		color: rgba(247, 245, 239, 0.72);
		font-family: var(--mono);
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
	}

	.panel-topline {
		top: 20px;
	}

	.panel-footer {
		bottom: 20px;
	}

	.network-map {
		position: absolute;
		inset: 62px 22px;
	}

	.route {
		position: absolute;
		height: 2px;
		border-radius: 999px;
		background: linear-gradient(90deg, transparent, var(--cyan), var(--lime), transparent);
		opacity: 0.78;
		transform-origin: left center;
		animation: route-pulse 4.8s ease-in-out infinite;
	}

	.route-a {
		top: 47%;
		left: 19%;
		width: 64%;
		transform: rotate(-18deg);
	}

	.route-b {
		top: 46%;
		left: 20%;
		width: 55%;
		transform: rotate(28deg);
		animation-delay: 0.8s;
	}

	.route-c {
		top: 46%;
		left: 23%;
		width: 52%;
		transform: rotate(92deg);
		animation-delay: 1.4s;
	}

	.node {
		position: absolute;
		z-index: 2;
		display: grid;
		place-items: center;
		border: 1px solid rgba(247, 245, 239, 0.22);
		background: rgba(247, 245, 239, 0.09);
		backdrop-filter: blur(10px);
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.24);
		text-align: center;
	}

	.node strong,
	.node span {
		font-family: var(--display);
		font-weight: 800;
	}

	.node small {
		color: rgba(247, 245, 239, 0.62);
		font-family: var(--mono);
		font-size: 0.62rem;
		font-weight: 600;
		text-transform: uppercase;
	}

	.node-main {
		top: 34%;
		left: 31%;
		width: min(42%, 210px);
		aspect-ratio: 1;
		border-color: rgba(183, 255, 74, 0.8);
		background: radial-gradient(circle, rgba(183, 255, 74, 0.28), rgba(247, 245, 239, 0.08) 70%);
		border-radius: 50%;
		box-shadow: 0 0 64px rgba(183, 255, 74, 0.22);
	}

	.node-main span {
		color: var(--lime);
		font-size: clamp(1rem, 2vw, 1.35rem);
	}

	.node-gdg,
	.node-tech,
	.node-ai,
	.node-hacker {
		width: 92px;
		height: 72px;
	}

	.node-gdg {
		top: 8%;
		left: 6%;
		border-color: rgba(183, 255, 74, 0.58);
	}

	.node-tech {
		top: 13%;
		right: 6%;
		border-color: rgba(34, 211, 197, 0.58);
	}

	.node-ai {
		right: 13%;
		bottom: 16%;
		border-color: rgba(115, 87, 255, 0.72);
	}

	.node-hacker {
		bottom: 10%;
		left: 8%;
		border-color: rgba(255, 98, 71, 0.68);
	}

	.pulse-dot {
		position: absolute;
		z-index: 1;
		width: 10px;
		height: 10px;
		border-radius: 999px;
		background: var(--lime);
		box-shadow: 0 0 0 8px rgba(183, 255, 74, 0.13);
		animation: float-dot 6s ease-in-out infinite;
	}

	.dot-one {
		top: 25%;
		left: 46%;
	}

	.dot-two {
		top: 62%;
		right: 22%;
		background: var(--cyan);
		box-shadow: 0 0 0 8px rgba(34, 211, 197, 0.13);
		animation-delay: 1.2s;
	}

	.dot-three {
		left: 22%;
		bottom: 25%;
		background: var(--coral);
		box-shadow: 0 0 0 8px rgba(255, 98, 71, 0.13);
		animation-delay: 2s;
	}

	.metrics {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border: 1px solid var(--ink);
		background: var(--ink);
		box-shadow: 6px 6px 0 var(--lime);
		color: var(--paper);
	}

	.metrics div {
		padding: 24px;
		border-right: 1px solid rgba(247, 245, 239, 0.18);
	}

	.metrics div:last-child {
		border-right: 0;
	}

	.metrics strong {
		display: block;
		margin-bottom: 4px;
		color: var(--lime);
		font-family: var(--display);
		font-size: clamp(2.1rem, 4vw, 4rem);
		line-height: 1;
	}

	.metrics span {
		color: rgba(247, 245, 239, 0.74);
		font-family: var(--mono);
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
	}

	.section {
		padding: 92px 0 0;
	}

	.intro-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(280px, 0.75fr);
		gap: clamp(28px, 6vw, 78px);
		align-items: start;
	}

	h2 {
		margin-bottom: 0;
		font-size: clamp(2.6rem, 6vw, 5.8rem);
		font-weight: 800;
		line-height: 0.95;
	}

	.intro-grid p,
	.section-heading > p,
	.submit-card p {
		color: #31403a;
		font-size: 1.08rem;
		line-height: 1.72;
	}

	.section-heading {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(260px, 0.45fr);
		gap: 32px;
		align-items: end;
		margin-bottom: 28px;
	}

	.community-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 14px;
	}

	.community-card {
		position: relative;
		display: flex;
		min-height: 390px;
		flex-direction: column;
		padding: 20px;
		border: 1px solid var(--line);
		background: rgba(247, 245, 239, 0.78);
		backdrop-filter: blur(18px);
		overflow: hidden;
		transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
	}

	.community-card::before {
		position: absolute;
		inset: 0 0 auto;
		height: 5px;
		content: "";
		background: var(--accent);
	}

	.community-card:hover {
		transform: translateY(-4px);
		border-color: rgba(8, 17, 15, 0.34);
		box-shadow: 0 18px 50px rgba(8, 17, 15, 0.1);
	}

	.accent-lime {
		--accent: var(--lime);
	}

