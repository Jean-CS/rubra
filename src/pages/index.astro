---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { formatEventDate, weekdayFormatter } from "../lib/eventDates";

const sortByName = <T extends { name: string }>(items: T[]) =>
	items.sort((a, b) => a.name.localeCompare(b.name, "pt-BR"));

const communities = sortByName(
	(await getCollection("communities", ({ data }) => data.draft !== true)).map(
		({ data }) => data,
	),
);

const institutions = sortByName(
	(await getCollection("institutions", ({ data }) => data.draft !== true)).map(
		({ data }) => data,
	),
);

const getDateKey = (date: Date) => date.toISOString().slice(0, 10);
const todayKey = getDateKey(new Date());

const publishedEvents = (
	await getCollection("events", ({ data }) => data.draft !== true)
)
	.map(({ data }) => data);

const upcomingEvents = publishedEvents
	.filter((event) => {
		const eventEnd = event.endDate ?? event.date;
		return getDateKey(eventEnd) >= todayKey;
	})
	.sort((a, b) => a.date.getTime() - b.date.getTime());

const githubIssueBaseUrl = "https://github.com/Jean-CS/rubra/issues/new";
const communityIssueUrl = `${githubIssueBaseUrl}?template=indicar-comunidade.yml`;
const institutionIssueUrl = `${githubIssueBaseUrl}?template=indicar-instituicao.yml`;
const eventIssueUrl = `${githubIssueBaseUrl}?template=indicar-evento.yml`;
const feedbackIssueUrl = `${githubIssueBaseUrl}?template=feedback.yml`;
const bugIssueUrl = `${githubIssueBaseUrl}?template=bug.yml`;
const eventsPageUrl = "/eventos";
const headerLinks = [
	{ href: "/comunidades", label: "Comunidades", accent: "lime" },
	{ href: "/instituicoes", label: "Ensino", accent: "cyan" },
	{ href: "#agenda", label: "Agenda", accent: "violet" },
	{ href: eventsPageUrl, label: "Eventos", accent: "coral" },
	{ href: "/sobre", label: "Sobre", accent: "violet" },
	{ href: "#participar", label: "Participar", accent: "lime" },
] as const;

const buildIssueUrl = (baseUrl: string, params: Record<string, string>) => {
	const url = new URL(baseUrl);

	Object.entries(params).forEach(([key, value]) => {
		url.searchParams.set(key, value);
	});

	return url.toString();
};

const communityUpdateIssueUrl = (community: (typeof communities)[number]) =>
	buildIssueUrl(communityIssueUrl, {
		title: `Atualizar comunidade: ${community.name}`,
		"request-type": "Atualização de comunidade existente",
		name: community.name,
		type: community.type,
		cadence: community.cadence,
		status: community.status,
		description: community.description,
		tags: community.tags.join(", "),
	});
const institutionUpdateIssueUrl = (institution: (typeof institutions)[number]) =>
	buildIssueUrl(institutionIssueUrl, {
		title: `Atualizar instituição: ${institution.name}`,
		"request-type": "Atualização de instituição existente",
		name: institution.name,
		website: institution.website,
		type: institution.type,
		profile: institution.profile,
		description: institution.description,
		tags: institution.tags.join(", "),
	});

const getEventDelay = (index: number) => `${(index * 0.1).toFixed(1)}s`;

const ecosystemTracks = [
	{
		name: "Comunidades",
		indexType: "COM",
		accent: "lime",
		href: "#comunidades",
	},
	{
		name: "Instituições de Ensino",
		indexType: "EDU",
		accent: "cyan",
		href: "#instituicoes",
	},
	{
		name: "Agenda",
		indexType: "EVT",
		accent: "violet",
		href: "#agenda",
	},
	{
		name: "Novas iniciativas",
		indexType: "NEW",
		accent: "coral",
		href: "#participar",
	},
];

---

<Layout>
	<div class="site-shell">
		<SiteHeader links={headerLinks} />

		<main>
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy reveal">
					<p class="eyebrow">Londrina e região · Hub tech do norte do PR</p>
					<h1 id="hero-title">
						<span>A porta de entrada</span>
						<span>para a cena tech</span>
						<span>de Londrina.</span>
					</h1>
					<p class="hero-lede">
						Para quem organiza, estuda, contrata, ensina ou quer entrar na cena tech de Londrina: tudo que existe aqui, reunido em um só lugar.
					</p>
					<div class="hero-actions">
						<a class="button button-primary" href="#comunidades">Explorar o mapa</a>
						<a class="button button-secondary" href="#participar">Colocar sua iniciativa no mapa</a>
					</div>
					<div class="hero-strip" aria-label="Partes do ecossistema mapeadas">
						<span>Mapeando agora</span>
						<strong>Comunidades</strong>
						<strong>Instituições de Ensino</strong>
						<strong>Eventos</strong>
						<strong>Iniciativas</strong>
					</div>
				</div>

				<div class="index-panel reveal" aria-label="Prévia do mapa da cena tech de Londrina">
					<div class="panel-topline">
						<span>Diretório regional</span>
						<span>23°18'S · 51°10'W</span>
					</div>
					<div class="index-board">
						<div class="index-stamp" aria-hidden="true">R</div>
						<div class="index-heading">
							<span>Ecossistema / Londrina e região</span>
							<strong>Índice da cena tech regional.</strong>
						</div>
						<div class="index-list">
							{
								ecosystemTracks.map((track, index) => (
									<a class={`index-row accent-${track.accent}`} href={track.href}>
										<span class="index-number">{String(index + 1).padStart(2, "0")}</span>
										<strong>{track.name}</strong>
										<span class="index-type">{track.indexType}</span>
									</a>
								))
							}
						</div>
					</div>
					<div class="panel-footer">
						<span>{communities.length + institutions.length} entradas mapeadas</span>
						<span>Aberto a sugestões e críticas</span>
					</div>
				</div>
			</section>

			<section class="metrics" aria-label="Resumo do projeto">
				<div>
					<strong>1,1M+</strong>
				<span>pessoas na região metropolitana</span>
			</div>
			<div>
				<strong>{communities.length}</strong>
				<span>comunidades mapeadas</span>
			</div>
			<div>
				<strong>{institutions.length}</strong>
				<span>Instituições de Ensino</span>
			</div>
			<div>
				<strong>{publishedEvents.length}</strong>
				<span>eventos mapeados</span>
			</div>
		</section>

		<section class="positioning-section" aria-labelledby="positioning-title">
			<div class="positioning-copy">
				<p class="section-kicker">Infraestrutura comunitária</p>
				<h2 id="positioning-title">Londrina tem gente construindo.</h2>
				<p>
					Organizadores, estudantes, professores, desenvolvedores seniores que mentoram, empresas que contratam localmente. Rubra existe para reunir o que essas pessoas constroem. Quando alguém aponta uma ausência ou questiona um critério, o mapa muda: quem está aqui tem mais autoridade sobre a cena do que qualquer definição externa.
				</p>
			</div>
			<div class="positioning-points" aria-label="Como Rubra evolui">
				<p>
					<strong>Curadoria</strong>
					<span>Cada entrada tem contexto mínimo de verificação porque confiança é o que mantém o mapa útil para quem organiza, contrata e estuda em Londrina.</span>
				</p>
				<p>
					<strong>Comunidade define</strong>
					<span>Quem vive a cena tech de Londrina tem mais autoridade para apontar o que está errado do que qualquer critério externo.</span>
				</p>
				<p>
					<strong>Infraestrutura</strong>
					<span>Se o mapa não reflete bem quem está construindo a cena, ele precisa mudar. Esse julgamento é de quem está aqui.</span>
				</p>
			</div>
		</section>

		<section class="section directory-section" id="comunidades" aria-labelledby="directory-title">
			<div class="section-heading">
				<div>
					<p class="section-kicker">Diretório regional</p>
					<h2 id="directory-title">Comunidades em destaque</h2>
				</div>
				<p>
					Um mapa vivo, feito para crescer com contribuições da própria comunidade.
				</p>
			</div>

			<div class="community-grid">
				{
					communities.map((community) => (
						<article class={`community-card accent-${community.accent}`}>
							<div class="card-header">
								<p>{community.type}</p>
								<span>{community.status}</span>
							</div>
							<h3>{community.name}</h3>
							<p>{community.description}</p>
							<div class="tag-row">
								{community.tags.map((tag) => (
									<span>{tag}</span>
								))}
							</div>
							<div class="card-footer">
								<span>{community.cadence}</span>
								<a href={communityUpdateIssueUrl(community)} aria-label={`Atualizar dados de ${community.name}`}>
									Atualizar
								</a>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section class="section institution-section" id="instituicoes" aria-labelledby="institutions-title">
			<div class="section-heading">
				<div>
					<p class="section-kicker">Instituições de Ensino</p>
					<h2 id="institutions-title">Onde a formação tech também acontece.</h2>
				</div>
				<p>
					Universidades, institutos e centros de formação entram no mapa porque também
					abrem portas para estudantes, projetos, pesquisa, eventos e novas conexões
					com a cena local.
				</p>
			</div>

			<div class="community-grid institution-grid">
				{
					institutions.map((institution) => (
							<article class={`community-card institution-card accent-${institution.accent}`}>
								<div class="card-header">
									<p>{institution.type}</p>
									{institution.profile && <span>{institution.profile}</span>}
								</div>
							<h3>{institution.name}</h3>
							<p>{institution.description}</p>
							<div class="tag-row">
								{institution.tags.map((tag) => (
									<span>{tag}</span>
								))}
							</div>
							<div class="card-footer">
								<a
									class="website-link"
									href={institution.website}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`Abrir site de ${institution.name} em nova aba`}
								>
									<svg aria-hidden="true" viewBox="0 0 24 24">
										<circle cx="12" cy="12" r="10"></circle>
										<path d="M2 12h20"></path>
										<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
									</svg>
								</a>
								<div class="card-actions">
									<a href={institutionUpdateIssueUrl(institution)} aria-label={`Atualizar dados de ${institution.name}`}>
										Atualizar
									</a>
								</div>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section class="event-section" id="agenda" aria-labelledby="events-title">
			<div class="event-copy">
				<p class="section-kicker">Agenda</p>
				<h2 id="events-title">Próximos eventos</h2>
				<p>
					Encontros datados de comunidades e Instituições de Ensino da cena tech de
					Londrina e região, publicados depois de curadoria manual.
				</p>
				<div class="event-copy-actions">
					<a class="button button-secondary" href={eventIssueUrl}>Indicar evento</a>
					<a class="button button-primary" href={eventsPageUrl}>Ver histórico</a>
				</div>
			</div>
			<div class="event-board" aria-label="Agenda de eventos">
				{
					upcomingEvents.length > 0 ? (
						upcomingEvents.map((event, index) => (
							<article class="event-card" style={`--delay: ${getEventDelay(index)}`}>
								<div class="event-date">
									<strong>{formatEventDate(event.date, event.endDate)}</strong>
									<span>{weekdayFormatter.format(event.date).replace(".", "")}</span>
								</div>
								<div class="event-body">
									<div class="event-meta">
										<span>{event.format}</span>
										{event.time && <span>{event.time}</span>}
										<span>{event.location}</span>
									</div>
									<h3>
										<a href={event.url} target="_blank" rel="noopener noreferrer">
											{event.title}
										</a>
									</h3>
									<p>{event.description}</p>
									<div class="event-footer">
										<span>
											{event.organizerName} · {event.organizerType}
										</span>
										<div class="tag-row event-tags">
											{event.tags.map((tag) => (
												<span>{tag}</span>
											))}
										</div>
									</div>
								</div>
							</article>
						))
					) : (
						<div class="empty-events">
							<strong>Nenhum próximo evento publicado ainda.</strong>
							<p>Indique um evento datado com contexto suficiente para a curadoria revisar.</p>
							<a class="button button-primary" href={eventIssueUrl}>Indicar evento</a>
						</div>
					)
				}
				<div class="event-archive-link">
					<span>{publishedEvents.length} eventos mapeados</span>
					<a href={eventsPageUrl}>Abrir agenda completa</a>
				</div>
			</div>
		</section>

		<section class="section submit-section" id="participar" aria-labelledby="submit-title">
			<span id="indicar" class="anchor-alias" aria-hidden="true"></span>
			<div class="submit-card">
				<h2 id="submit-title">Esta infraestrutura é sua.</h2>
				<p>
					Rubra é infraestrutura compartilhada. Organizadores, estudantes, professores, desenvolvedores e empresas de Londrina indicam conteúdo, atualizam dados e propõem mudanças na forma como o mapa representa a cena. As contribuições entram pelo GitHub e passam por curadoria antes de publicar.
				</p>
				<div class="submit-flow" aria-label="Opções de participação">
					<p>
						<strong>Comunidade</strong>
						<span>Para grupos, meetups, coletivos, labs e iniciativas recorrentes.</span>
					</p>
					<p>
						<strong>Instituição de Ensino</strong>
						<span>Para universidades, institutos, centros de formação e cursos relevantes.</span>
					</p>
					<p>
						<strong>Evento</strong>
						<span>Para encontros datados com página pública e relação clara com tecnologia.</span>
					</p>
					<p>
						<strong>Sugestão ou crítica</strong>
						<span>Para melhorias de conteúdo, curadoria, navegação, tom, acessibilidade ou visual.</span>
					</p>
					<p>
						<strong>Problema ou bug</strong>
						<span>Para links quebrados, dados incorretos, falhas de layout ou comportamento inesperado.</span>
					</p>
				</div>
				<div class="submit-actions">
					<a class="button button-primary" href={communityIssueUrl}>
						Indicar comunidade
					</a>
					<a class="button button-secondary" href={institutionIssueUrl}>
						Indicar Instituição de Ensino
					</a>
					<a class="button button-secondary" href={eventIssueUrl}>
						Indicar evento
					</a>
					<a class="button button-secondary" href={feedbackIssueUrl}>
						Sugerir melhoria
					</a>
					<a class="button button-secondary" href={bugIssueUrl}>
						Reportar problema
					</a>
				</div>
				</div>
			</section>
		</main>
		<SiteFooter />
	</div>
</Layout>

<style>
	:root {
		--ink: #160f0b;
		--paper: #f8f1e7;
		--mist: #eadfce;
		--lime: #b7ff4a;
		--cyan: #22d3c5;
		--coral: #ff6247;
		--red: #e53935;
		--violet: #6f5ae8;
		--coffee: #4b2117;
		--steel: #766a5e;
		--line: rgba(22, 15, 11, 0.14);
		--shadow: 0 28px 80px rgba(55, 27, 15, 0.16);
		--display: "Bricolage Grotesque", "IBM Plex Sans", sans-serif;
		--body: "IBM Plex Sans", system-ui, sans-serif;
		--mono: "IBM Plex Mono", ui-monospace, monospace;
	}

	.site-shell {
		--page-gutter: clamp(18px, 3.8vw, 40px);
		position: relative;
		min-height: 100svh;
		min-height: 100dvh;
		overflow-x: clip;
		background:
			radial-gradient(circle at 16% 8%, rgba(183, 255, 74, 0.32), transparent 26rem),
			radial-gradient(circle at 84% 10%, rgba(34, 211, 197, 0.2), transparent 24rem),
			linear-gradient(120deg, rgba(159, 47, 28, 0.14), transparent 28rem),
			var(--paper);
	}

	.site-shell::before {
		position: absolute;
		inset: 0;
		pointer-events: none;
		content: "";
		background-image:
			linear-gradient(rgba(22, 15, 11, 0.055) 1px, transparent 1px),
			linear-gradient(90deg, rgba(22, 15, 11, 0.055) 1px, transparent 1px);
		background-size: 42px 42px;
		mask-image: linear-gradient(to bottom, #000 0%, transparent 72%);
	}

	.site-shell::after {
		position: absolute;
		inset: 0;
		pointer-events: none;
		content: "";
		opacity: 0.34;
		background-image:
			linear-gradient(115deg, transparent 0 44%, rgba(22, 15, 11, 0.08) 44% 44.3%, transparent 44.3%),
			linear-gradient(25deg, transparent 0 72%, rgba(22, 15, 11, 0.06) 72% 72.2%, transparent 72.2%);
	}

	.nav,
	.hero,
	.metrics,
	.positioning-section,
	.section,
	.event-section {
		position: relative;
		z-index: 1;
		width: min(1180px, calc(100% - (var(--page-gutter) * 2)));
		margin-inline: auto;
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: clamp(64px, 8dvh, 84px);
		padding: clamp(14px, 2dvh, 24px) 0;
	}

	.brand,
	.nav-links {
		display: flex;
		align-items: center;
	}

	.brand {
		gap: 10px;
		color: var(--ink);
		font-family: var(--display);
		font-size: 1.04rem;
		font-weight: 800;
		text-decoration: none;
	}

	.brand-mark {
		display: grid;
		width: 34px;
		height: 34px;
		place-items: center;
		border: 1px solid var(--ink);
		background: var(--lime);
		box-shadow: 4px 4px 0 var(--ink);
		color: var(--ink);
		font-family: var(--mono);
		font-size: 0.85rem;
	}

	.nav-links {
		gap: 8px;
		padding: 6px;
		border: 1px solid var(--line);
		background: rgba(248, 241, 231, 0.72);
		backdrop-filter: blur(16px);
	}

	.nav-links a {
		padding: 10px 12px;
		color: var(--steel);
		font-size: 0.88rem;
		font-weight: 700;
		text-decoration: none;
		transition: color 180ms ease, background 180ms ease;
	}

	.nav-links a:hover {
		background: var(--ink);
		color: var(--paper);
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(360px, 0.78fr);
		gap: clamp(30px, 4.8vw, 78px);
		align-items: center;
		min-height: 0;
		padding: clamp(12px, 2.2dvh, 28px) 0 clamp(22px, 4.8dvh, 54px);
	}

	.hero-copy {
		max-width: 780px;
	}

	.eyebrow,
	.section-kicker {
		margin: 0 0 clamp(12px, 1.8dvh, 18px);
		color: var(--steel);
		font-family: var(--mono);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1,
	h2,
	h3 {
		font-family: var(--display);
		letter-spacing: 0;
	}

	h1 {
		max-width: 12ch;
		margin-bottom: clamp(15px, 2.4dvh, 24px);
		font-size: clamp(3.45rem, min(6.9vw, 10.4dvh), 5rem);
		font-weight: 800;
		line-height: 0.92;
	}

	h1 span {
		display: block;
	}

	.hero-lede {
		max-width: 640px;
		margin-bottom: clamp(18px, 2.6dvh, 26px);
		color: #4a3c31;
		font-size: clamp(1rem, min(1.55vw, 2.3dvh), 1.24rem);
		line-height: 1.56;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.hero-strip {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		align-items: center;
		max-width: 660px;
		margin-top: clamp(18px, 2.8dvh, 28px);
	}

	.hero-strip span,
	.hero-strip strong {
		display: inline-flex;
		align-items: center;
		min-height: 34px;
		padding: 0 10px;
		border: 1px solid var(--line);
		background: rgba(248, 241, 231, 0.72);
		font-family: var(--mono);
		font-size: 0.68rem;
		font-weight: 600;
		text-transform: uppercase;
	}

	.hero-strip span {
		border-color: var(--ink);
		background: var(--ink);
		color: var(--paper);
	}

	.hero-strip strong:nth-of-type(1) {
		box-shadow: inset 0 4px 0 var(--lime);
	}

	.hero-strip strong:nth-of-type(2) {
		box-shadow: inset 0 4px 0 var(--cyan);
	}

	.hero-strip strong:nth-of-type(3) {
		box-shadow: inset 0 4px 0 var(--violet);
	}

	.hero-strip strong:nth-of-type(4) {
		box-shadow: inset 0 4px 0 var(--coral);
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		padding: 0 18px;
		border: 1px solid var(--ink);
		font-weight: 800;
		text-decoration: none;
		transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
	}

	.button:hover {
		transform: translateY(-2px);
	}

	.button-primary {
		background: var(--lime);
