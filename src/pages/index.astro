		box-shadow: var(--shadow);
		color: var(--paper);
		overflow: hidden;
		transform: translateY(-8px);
	}

	.index-panel::before {
		position: absolute;
		inset: 0;
		content: "";
		background-image:
			linear-gradient(rgba(248, 241, 231, 0.08) 1px, transparent 1px),
			linear-gradient(90deg, rgba(248, 241, 231, 0.08) 1px, transparent 1px);
		background-size: 36px 36px;
		mask-image: linear-gradient(to bottom, #000, transparent 88%);
	}

	.index-panel::after {
		position: absolute;
		inset: auto -12% -24% 22%;
		height: 280px;
		content: "";
		background: radial-gradient(circle, rgba(185, 67, 43, 0.46), transparent 68%);
		filter: blur(10px);
	}

	.panel-topline,
	.panel-footer {
		position: absolute;
		z-index: 2;
		right: 22px;
		left: 22px;
		display: flex;
		justify-content: space-between;
		gap: 20px;
		color: rgba(248, 241, 231, 0.72);
		font-family: var(--mono);
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
	}

	.panel-topline {
		top: 20px;
	}

	.panel-footer {
		bottom: 20px;
	}

	.index-board {
		position: absolute;
		z-index: 2;
		inset: 72px 22px 84px;
		display: grid;
		grid-template-rows: auto minmax(0, 1fr);
		gap: clamp(16px, 3dvh, 28px);
		min-height: 0;
	}

	.index-stamp {
		position: absolute;
		right: 0;
		bottom: -10px;
		z-index: -1;
		color: rgba(248, 241, 231, 0.035);
		font-family: var(--display);
		font-size: clamp(12rem, 22vw, 18rem);
		font-weight: 800;
		line-height: 0.72;
	}

	.index-heading {
		display: grid;
		gap: 10px;
		max-width: 520px;
	}

	.index-heading span,
	.index-type,
	.index-number {
		font-family: var(--mono);
		font-size: 0.7rem;
		font-weight: 600;
		text-transform: uppercase;
	}

	.index-heading span {
		color: rgba(248, 241, 231, 0.62);
	}

	.index-heading strong {
		color: var(--lime);
		font-family: var(--display);
		font-size: clamp(1.75rem, min(2.85vw, 4.5dvh), 2rem);
		font-weight: 800;
		line-height: 0.98;
	}

	.index-list {
		display: grid;
		grid-template-rows: repeat(4, minmax(0, 1fr));
		gap: 10px;
		min-height: 0;
	}

	.index-row {
		--accent: var(--lime);
		position: relative;
		display: grid;
		grid-template-columns: 42px minmax(0, 1fr) auto;
		gap: 14px;
		align-items: center;
		min-height: 0;
		padding: 0 clamp(14px, 2vw, 20px);
		border: 1px solid rgba(248, 241, 231, 0.14);
		background: rgba(248, 241, 231, 0.075);
		color: var(--paper);
		text-decoration: none;
		backdrop-filter: blur(14px);
		transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
	}

	.index-row::before {
		position: absolute;
		inset: 0 auto 0 0;
		width: 4px;
		content: "";
		background: var(--accent);
	}

	.index-row:hover {
		transform: translateX(4px);
		border-color: color-mix(in srgb, var(--accent) 58%, transparent);
		background: rgba(248, 241, 231, 0.12);
	}

	.index-row strong {
		min-width: 0;
		font-family: var(--display);
		font-size: clamp(1.1rem, min(1.85vw, 2.7dvh), 1.45rem);
		font-weight: 800;
		line-height: 1;
		overflow-wrap: anywhere;
	}

	.index-number {
		color: rgba(248, 241, 231, 0.48);
	}

	.index-type {
		display: inline-grid;
		min-width: 54px;
		min-height: 32px;
		place-items: center;
		border: 1px solid color-mix(in srgb, var(--accent) 62%, transparent);
		color: var(--accent);
	}

	.metrics {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		border: 1px solid var(--ink);
		background: var(--ink);
		box-shadow: 6px 6px 0 var(--lime);
		color: var(--paper);
	}

	.metrics div {
		padding: 24px;
		border-right: 1px solid rgba(248, 241, 231, 0.18);
	}

	.metrics div:last-child {
		border-right: 0;
	}

	.metrics strong {
		display: block;
		margin-bottom: 4px;
		color: var(--lime);
		font-family: var(--display);
		font-size: clamp(2.1rem, 4vw, 4rem);
		line-height: 1;
	}

	.metrics span {
		color: rgba(248, 241, 231, 0.74);
		font-family: var(--mono);
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
	}

	.section {
		padding: 92px 0 0;
	}

	h2 {
		margin-bottom: 0;
		font-size: clamp(2.6rem, 6vw, 5.8rem);
		font-weight: 800;
		line-height: 0.95;
	}

	.section-heading > p,
	.positioning-copy p,
	.positioning-points span,
	.submit-card p,
	.submit-flow span,
	.empty-events p,
	.event-body p {
		color: #4a3c31;
		font-size: 1.08rem;
		line-height: 1.72;
	}

	.section-heading {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(260px, 0.45fr);
		gap: 32px;
		align-items: end;
		margin-bottom: 28px;
	}

	.positioning-section {
		display: grid;
		grid-template-columns: minmax(0, 0.82fr) minmax(360px, 0.68fr);
		gap: clamp(24px, 5vw, 64px);
		align-items: stretch;
		margin-top: clamp(64px, 8vw, 96px);
		border: 1px solid var(--ink);
		background:
			linear-gradient(rgba(248, 241, 231, 0.075) 1px, transparent 1px),
			linear-gradient(90deg, rgba(248, 241, 231, 0.075) 1px, transparent 1px),
			linear-gradient(135deg, rgba(22, 15, 11, 0.98), rgba(75, 33, 23, 0.96));
		background-size: 34px 34px, 34px 34px, auto;
		box-shadow: 7px 7px 0 var(--coral);
		color: var(--paper);
		overflow: hidden;
		padding: clamp(26px, 5vw, 56px);
	}

	.positioning-section::after {
		position: absolute;
		right: clamp(18px, 4vw, 48px);
		bottom: clamp(-18px, -2vw, -8px);
		content: "aberto";
		color: rgba(248, 241, 231, 0.04);
		font-family: var(--display);
		font-size: clamp(5rem, 13vw, 11rem);
		font-weight: 800;
		line-height: 0.8;
		pointer-events: none;
	}

	.positioning-copy,
	.positioning-points {
		position: relative;
		z-index: 1;
	}

	.positioning-copy .section-kicker {
		color: rgba(248, 241, 231, 0.68);
	}

	.positioning-copy h2 {
		max-width: 7.8ch;
		color: var(--lime);
	}

	.positioning-copy p {
		max-width: 660px;
		margin: 22px 0 0;
		color: rgba(248, 241, 231, 0.78);
	}

	.positioning-points {
		display: grid;
		gap: 12px;
		align-content: center;
	}

	.positioning-points p {
		display: grid;
		gap: 8px;
		margin: 0;
		padding: 18px 18px 18px 18px;
		border-left: 4px solid var(--accent);
		background: rgba(248, 241, 231, 0.07);
	}

	.positioning-points p:nth-child(1) {
		--accent: var(--lime);
	}

	.positioning-points p:nth-child(2) {
		--accent: var(--cyan);
	}

	.positioning-points p:nth-child(3) {
		--accent: var(--coral);
	}

	.positioning-points strong {
		color: var(--accent);
		font-family: var(--display);
		font-size: 1.2rem;
		line-height: 1;
	}

	.positioning-points span {
		max-width: 440px;
		color: rgba(248, 241, 231, 0.72);
		font-size: 0.98rem;
		line-height: 1.5;
	}

	.community-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 14px;
	}

	.community-card {
		position: relative;
		display: flex;
		min-height: 390px;
		flex-direction: column;
		padding: 20px;
		border: 1px solid var(--line);
		background: rgba(248, 241, 231, 0.78);
		backdrop-filter: blur(18px);
		overflow: hidden;
		transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
	}

	.community-card::before {
		position: absolute;
		inset: 0 0 auto;
		height: 5px;
		content: "";
		background: var(--accent);
	}

	.community-card:hover {
		transform: translateY(-4px);
		border-color: rgba(22, 15, 11, 0.34);
		box-shadow: 0 18px 50px rgba(55, 27, 15, 0.12);
	}

	.accent-lime {
		--accent: var(--lime);
	}

	.accent-cyan {
		--accent: var(--cyan);
	}

	.accent-violet {
		--accent: var(--violet);
	}

	.accent-coral {
		--accent: var(--coral);
	}

	.accent-red {
		--accent: var(--red);
	}

	.card-header,
	.card-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 14px;
	}

	.card-header p,
	.card-header span,
	.card-footer,
	.tag-row span {
		font-family: var(--mono);
		font-size: 0.68rem;
		font-weight: 600;
		text-transform: uppercase;
	}

	.card-header {
		margin-bottom: 34px;
		color: var(--steel);
	}

	.card-header p {
		margin: 0;
	}

	.card-header span {
		padding: 6px 8px;
		background: var(--accent);
		color: var(--ink);
	}

	.community-card h3 {
		margin-bottom: 16px;
		font-size: clamp(1.7rem, 2.3vw, 2.25rem);
		font-weight: 800;
		line-height: 0.95;
	}

	.community-card > p {
		color: #514236;
		line-height: 1.58;
	}

	.institution-card {
		min-height: 320px;
	}

	.tag-row {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
		margin-top: auto;
		padding-top: 26px;
