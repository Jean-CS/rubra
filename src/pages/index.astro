	}

	.button-secondary {
		background: rgba(248, 241, 231, 0.72);
		color: var(--ink);
	}

	.button-secondary:hover {
		background: var(--ink);
		color: var(--paper);
	}

	.index-panel {
		position: relative;
		align-self: center;
		height: clamp(380px, 62dvh, 620px);
		min-height: 0;
		border: 1px solid rgba(22, 15, 11, 0.24);
		background:
			linear-gradient(135deg, rgba(22, 15, 11, 0.98), rgba(75, 33, 23, 0.94)),
